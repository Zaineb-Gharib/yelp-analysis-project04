# App
APP_NAME=Hive Copilot
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api
STREAMLIT_BACKEND_URL=http://127.0.0.1:8000
FRONTEND_MODE=api

# HiveServer2 / Beeline
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DATABASE=yelp
HIVE_USERNAME=
HIVE_PASSWORD=
HIVE_AUTH=NONE
HIVE_USE_SSL=false
HIVE_KERBEROS_SERVICE=

# Hive Metastore
HMS_HOST=localhost
HMS_PORT=9083
HMS_AUTH=NONE
HMS_USERNAME=
HMS_PASSWORD=
HMS_USE_SSL=false

# LLM providers
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=

# Optional app URL
APP_URL=http://localhost:8501
