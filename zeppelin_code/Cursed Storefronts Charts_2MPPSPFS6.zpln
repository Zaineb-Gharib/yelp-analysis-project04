    {
      "text": "%pyspark\nfrom wordcloud import WordCloud\nimport matplotlib.pyplot as plt\n\n# Data from your pain points\nwords_counts \u003d {\n    \u0027food\u0027: 268390, \u0027good\u0027: 230690, \u0027place\u0027: 213610, \u0027great\u0027: 182120,\n    \u0027service\u0027: 137138, \u0027time\u0027: 116317, \u0027ordered\u0027: 88384, \u0027restaurant\u0027: 83976,\n    \u0027menu\u0027: 83783, \u0027delicious\u0027: 77061, \u0027chicken\u0027: 74169, \u0027parking\u0027: 45000\n}\n\n# Generate word cloud\nwordcloud \u003d WordCloud(width\u003d1200, height\u003d600, background_color\u003d\u0027white\u0027,\n                      colormap\u003d\u0027Reds\u0027, max_words\u003d50, relative_scaling\u003d0.5).generate_from_frequencies(words_counts)\n\nfig, ax \u003d plt.subplots(figsize\u003d(14, 7))\nax.imshow(wordcloud, interpolation\u003d\u0027bilinear\u0027)\nax.axis(\u0027off\u0027)\nax.set_title(\u0027What Customers Talk About at Cursed Locations\u0027, fontsize\u003d16, fontweight\u003d\u0027bold\u0027, pad\u003d20)\n\nplt.tight_layout()\nplt.show()",
