      "text": "%pyspark\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport os\n\n# Create directory\nos.makedirs(\"/data/charts\", exist_ok\u003dTrue)\n\nprint(\"Saving Chart 1: Parking Donut\")\n\nlabels \u003d [\u0027No Parking\u0027, \u0027Has Parking\u0027]\nsizes \u003d [59.6, 40.4]\ncolors \u003d [\u0027#d32323\u0027, \u0027#2c3e50\u0027]\n\nfig, ax \u003d plt.subplots(figsize\u003d(8, 8))\nax.pie(sizes, labels\u003dlabels, colors\u003dcolors, autopct\u003d\u0027%1.1f%%\u0027, startangle\u003d90, pctdistance\u003d0.85)\ncentre_circle \u003d plt.Circle((0, 0), 0.70, fc\u003d\u0027white\u0027, linewidth\u003d2)\nfig.gca().add_artist(centre_circle)\nax.set_title(\u0027Parking at Cursed Storefronts\u0027, fontsize\u003d14, fontweight\u003d\u0027bold\u0027)\nplt.savefig(\u0027/data/charts/parking_cursed.png\u0027, dpi\u003d150, bbox_inches\u003d\u0027tight\u0027)\nplt.close()\nprint(\"✓ Saved: /data/charts/parking_cursed.png\")",
