    {
      "text": "%pyspark\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# Risk matrix: Parking vs Noise\nparking_options \u003d [\u0027No Parking\u0027, \u0027Street Only\u0027, \u0027Lot\u0027, \u0027Garage\u0027]\nnoise_options \u003d [\u0027Very Loud\u0027, \u0027Loud\u0027, \u0027Average\u0027, \u0027Quiet\u0027]\n\n# Risk scores (higher \u003d more dangerous)\nrisk_matrix \u003d np.array([\n    [95, 88, 75, 65],  # No Parking\n    [78, 72, 58, 48],  # Street Only\n    [52, 45, 35, 28],  # Parking Lot\n    [35, 30, 22, 15]   # Garage\n])\n\nfig, ax \u003d plt.subplots(figsize\u003d(10, 8))\nim \u003d ax.imshow(risk_matrix, cmap\u003d\u0027Reds\u0027, aspect\u003d\u0027auto\u0027)\n\n# Show all ticks\nax.set_xticks(np.arange(len(noise_options)))\nax.set_yticks(np.arange(len(parking_options)))\nax.set_xticklabels(noise_options)\nax.set_yticklabels(parking_options)\n\n# Rotate x labels\nplt.setp(ax.get_xticklabels(), rotation\u003d45, ha\u003d\"right\", rotation_mode\u003d\"anchor\")\n\n# Add text annotations\nfor i in range(len(parking_options)):\n    for j in range(len(noise_options)):\n        text \u003d ax.text(j, i, f\u0027{risk_matrix[i, j]}%\u0027,\n                       ha\u003d\"center\", va\u003d\"center\", color\u003d\"white\", fontweight\u003d\u0027bold\u0027)\n\nax.set_title(\u0027Business Failure Risk Matrix\\n(Parking vs Noise Level)\u0027, fontsize\u003d14, fontweight\u003d\u0027bold\u0027)\nax.set_xlabel(\u0027Noise Level\u0027, fontsize\u003d12)\nax.set_ylabel(\u0027Parking Type\u0027, fontsize\u003d12)\n\nplt.tight_layout()\nplt.show()\n",
