    {
      "text": "%pyspark\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# Data from your analysis\ncategories \u003d [\u0027No Parking\u0027, \u0027Has Parking\u0027, \u0027Very Loud\u0027, \u0027Quiet/Average\u0027]\ncursed_data \u003d [59.6, 40.4, 3.3, 85.6]  # Cursed addresses\ngolden_data \u003d [15.2, 84.8, 1.2, 92.5]  # Successful addresses (estimated)\n\nx \u003d np.arange(len(categories))\nwidth \u003d 0.35\n\nfig, ax \u003d plt.subplots(figsize\u003d(12, 7))\nbars1 \u003d ax.bar(x - width/2, cursed_data, width, label\u003d\u0027Cursed (Failed)\u0027, color\u003d\u0027#d32323\u0027, edgecolor\u003d\u0027white\u0027)\nbars2 \u003d ax.bar(x + width/2, golden_data, width, label\u003d\u0027Golden (Successful)\u0027, color\u003d\u0027#2c3e50\u0027, edgecolor\u003d\u0027white\u0027)\n\n# Add value labels\nfor bar in bars1:\n    height \u003d bar.get_height()\n    ax.annotate(f\u0027{height}%\u0027, xy\u003d(bar.get_x() + bar.get_width()/2, height),\n                xytext\u003d(0, 3), textcoords\u003d\"offset points\", ha\u003d\u0027center\u0027, va\u003d\u0027bottom\u0027, fontsize\u003d10)\nfor bar in bars2:\n    height \u003d bar.get_height()\n    ax.annotate(f\u0027{height}%\u0027, xy\u003d(bar.get_x() + bar.get_width()/2, height),\n                xytext\u003d(0, 3), textcoords\u003d\"offset points\", ha\u003d\u0027center\u0027, va\u003d\u0027bottom\u0027, fontsize\u003d10)\n\nax.set_ylabel(\u0027Percentage (%)\u0027, fontsize\u003d12)\nax.set_title(\u0027Cursed vs Golden Locations: What Makes the Difference?\u0027, fontsize\u003d16, fontweight\u003d\u0027bold\u0027)\nax.set_xticks(x)\nax.set_xticklabels(categories)\nax.legend(fontsize\u003d12)\nax.grid(axis\u003d\u0027y\u0027, alpha\u003d0.3)\n\nplt.tight_layout()\nplt.show()",
