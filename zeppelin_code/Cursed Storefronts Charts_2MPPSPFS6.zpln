    {
      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Data\nparking_types \u003d [\u0027No Parking\u0027, \u0027Street Only\u0027, \u0027Parking Lot\u0027, \u0027Garage\u0027]\nfailure_rates \u003d [85.2, 62.3, 34.7, 18.5]  # Estimated failure rates\ncolors \u003d [\u0027#d32323\u0027, \u0027#e67e22\u0027, \u0027#f1c40f\u0027, \u0027#2ecc71\u0027]\n\nfig, ax \u003d plt.subplots(figsize\u003d(10, 6))\nbars \u003d ax.bar(parking_types, failure_rates, color\u003dcolors, edgecolor\u003d\u0027white\u0027, linewidth\u003d2)\n\n# Add value labels\nfor bar, rate in zip(bars, failure_rates):\n    height \u003d bar.get_height()\n    ax.text(bar.get_x() + bar.get_width()/2., height + 1,\n            f\u0027{rate}%\u0027, ha\u003d\u0027center\u0027, va\u003d\u0027bottom\u0027, fontsize\u003d12, fontweight\u003d\u0027bold\u0027)\n\nax.set_title(\u0027Business Failure Rate by Parking Type\u0027, fontsize\u003d16, fontweight\u003d\u0027bold\u0027)\nax.set_ylabel(\u0027Failure Rate (%)\u0027, fontsize\u003d12)\nax.set_ylim(0, 100)\nax.grid(axis\u003d\u0027y\u0027, alpha\u003d0.3)\n\n# Add annotation\nax.annotate(\u0027High Risk\u0027, xy\u003d(0, 85), xytext\u003d(0.5, 90),\n            arrowprops\u003ddict(arrowstyle\u003d\u0027-\u003e\u0027, color\u003d\u0027#d32323\u0027),\n            fontsize\u003d10, ha\u003d\u0027center\u0027)\n\nax.annotate(\u0027Low Risk\u0027, xy\u003d(3, 18), xytext\u003d(2.5, 30),\n            arrowprops\u003ddict(arrowstyle\u003d\u0027-\u003e\u0027, color\u003d\u0027#2ecc71\u0027),\n            fontsize\u003d10, ha\u003d\u0027center\u0027)\n\nplt.tight_layout()\nplt.show()\n",
