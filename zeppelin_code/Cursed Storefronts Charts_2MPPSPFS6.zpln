      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Data\ncities \u003d [\u0027Philadelphia\u0027, \u0027Nashville\u0027, \u0027Reno\u0027, \u0027Santa Barbara\u0027, \u0027Tucson\u0027]\nfailures \u003d [56, 37, 37, 37, 36]\ncolors \u003d [\u0027#d32323\u0027, \u0027#e67e22\u0027, \u0027#f39c12\u0027, \u0027#f1c40f\u0027, \u0027#2ecc71\u0027]\n\n# Create bar chart\nfig, ax \u003d plt.subplots(figsize\u003d(10, 6))\nbars \u003d ax.bar(cities, failures, color\u003dcolors, edgecolor\u003d\u0027white\u0027, linewidth\u003d2)\n\n# Add value labels on top\nfor bar, count in zip(bars, failures):\n    height \u003d bar.get_height()\n    ax.text(bar.get_x() + bar.get_width()/2., height + 1,\n            f\u0027{count}\u0027, ha\u003d\u0027center\u0027, va\u003d\u0027bottom\u0027, fontsize\u003d12, fontweight\u003d\u0027bold\u0027)\n\nax.set_title(\u0027Top 5 Cursed Cities (Most Failures at One Address)\u0027, fontsize\u003d16, fontweight\u003d\u0027bold\u0027)\nax.set_xlabel(\u0027City\u0027, fontsize\u003d12)\nax.set_ylabel(\u0027Number of Failed Businesses\u0027, fontsize\u003d12)\nax.set_xticklabels(cities, rotation\u003d45, ha\u003d\u0027right\u0027)\nax.grid(axis\u003d\u0027y\u0027, alpha\u003d0.3)\n\nplt.tight_layout()\nplt.show()",
