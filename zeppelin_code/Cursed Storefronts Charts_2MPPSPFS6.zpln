    {
      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Data - year vs cumulative failures at cursed addresses\nyears \u003d [2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020]\ncumulative_failures \u003d [1500, 3200, 5100, 7200, 9500, 12300, 14500, 15800, 16500, 16800, 16950]\n\nfig, ax \u003d plt.subplots(figsize\u003d(12, 6))\nax.plot(years, cumulative_failures, marker\u003d\u0027o\u0027, linewidth\u003d2, markersize\u003d8, color\u003d\u0027#d32323\u0027)\nax.fill_between(years, cumulative_failures, alpha\u003d0.3, color\u003d\u0027#d32323\u0027)\n\n# Add annotations\nax.annotate(\u0027Peak failures 2014-2016\u0027, xy\u003d(2015, 12300), xytext\u003d(2012, 14000),\n            arrowprops\u003ddict(arrowstyle\u003d\u0027-\u003e\u0027, color\u003d\u0027gray\u0027), fontsize\u003d10)\n\nax.set_title(\u0027Cumulative Business Failures at Cursed Addresses (2010-2020)\u0027, fontsize\u003d14, fontweight\u003d\u0027bold\u0027)\nax.set_xlabel(\u0027Year\u0027, fontsize\u003d12)\nax.set_ylabel(\u0027Total Failures\u0027, fontsize\u003d12)\nax.grid(True, alpha\u003d0.3)\n\nplt.tight_layout()\nplt.show()\n",
