      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\nfig, axes \u003d plt.subplots(2, 2, figsize\u003d(14, 12))\nfig.suptitle(\u0027Cursed Storefronts Analysis Summary\u0027, fontsize\u003d18, fontweight\u003d\u0027bold\u0027)\n\n# 1. Parking (Top Left)\nax1 \u003d axes[0, 0]\nax1.pie([59.6, 40.4], labels\u003d[\u0027No Parking\u0027, \u0027Has Parking\u0027], colors\u003d[\u0027#d32323\u0027, \u0027#2c3e50\u0027],\n        autopct\u003d\u0027%1.1f%%\u0027, startangle\u003d90)\nax1.set_title(\u0027Parking\u0027, fontsize\u003d12, fontweight\u003d\u0027bold\u0027)\n\n# 2. Top 5 Pain Points (Top Right)\nax2 \u003d axes[0, 1]\ntop_words \u003d [\u0027food\u0027, \u0027good\u0027, \u0027place\u0027, \u0027great\u0027, \u0027like\u0027]\ntop_counts \u003d [268390, 230690, 213610, 182120, 142528]\nax2.barh(top_words, top_counts, color\u003d\u0027#d32323\u0027)\nax2.set_title(\u0027Top 5 Pain Points\u0027, fontsize\u003d12, fontweight\u003d\u0027bold\u0027)\nax2.set_xlabel(\u0027Frequency\u0027)\n\n# 3. Top 5 Cities (Bottom Left)\nax3 \u003d axes[1, 0]\ncities \u003d [\u0027Philadelphia\u0027, \u0027Nashville\u0027, \u0027Reno\u0027, \u0027Santa Barbara\u0027, \u0027Tucson\u0027]\nfailures \u003d [56, 37, 37, 37, 36]\nax3.bar(cities, failures, color\u003d\u0027#d32323\u0027)\nax3.set_title(\u0027Top 5 Cursed Cities\u0027, fontsize\u003d12, fontweight\u003d\u0027bold\u0027)\nax3.set_xticklabels(cities, rotation\u003d45, ha\u003d\u0027right\u0027)\nax3.set_ylabel(\u0027Failures\u0027)\n\n# 4. Noise (Bottom Right)\nax4 \u003d axes[1, 1]\nax4.pie([85.6, 7.7, 3.3, 3.4], labels\u003d[\u0027Quiet\u0027, \u0027Loud\u0027, \u0027Very Loud\u0027, \u0027Unknown\u0027],\n        colors\u003d[\u0027#2c3e50\u0027, \u0027#e67e22\u0027, \u0027#d32323\u0027, \u0027#95a5a6\u0027], autopct\u003d\u0027%1.1f%%\u0027)\nax4.set_title(\u0027Noise Level\u0027, fontsize\u003d12, fontweight\u003d\u0027bold\u0027)\n\nplt.tight_layout()\nplt.show()\n",
