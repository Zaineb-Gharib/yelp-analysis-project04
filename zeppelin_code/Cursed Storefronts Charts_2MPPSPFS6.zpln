      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Data (top 10 pain points)\nwords \u003d [\u0027food\u0027, \u0027good\u0027, \u0027place\u0027, \u0027great\u0027, \u0027like\u0027, \u0027service\u0027, \u0027back\u0027, \u0027time\u0027, \u0027really\u0027, \u0027also\u0027]\ncounts \u003d [268390, 230690, 213610, 182120, 142528, 137138, 123076, 116317, 112001, 94713]\n\n# Create horizontal bar chart\nfig, ax \u003d plt.subplots(figsize\u003d(12, 8))\nbars \u003d ax.barh(words, counts, color\u003d\u0027#d32323\u0027, edgecolor\u003d\u0027white\u0027, linewidth\u003d1)\n\n# Add value labels\nfor bar, count in zip(bars, counts):\n    width \u003d bar.get_width()\n    ax.text(width + 3000, bar.get_y() + bar.get_height()/2,\n            f\u0027{count:,}\u0027, ha\u003d\u0027left\u0027, va\u003d\u0027center\u0027, fontsize\u003d10)\n\nax.set_title(\u0027Top 10 Words in Reviews from Cursed Locations\u0027, fontsize\u003d16, fontweight\u003d\u0027bold\u0027)\nax.set_xlabel(\u0027Number of Times Mentioned\u0027, fontsize\u003d12)\nax.set_ylabel(\u0027Word\u0027, fontsize\u003d12)\nax.grid(axis\u003d\u0027x\u0027, alpha\u003d0.3)\n\nplt.tight_layout()\nplt.show()\n",
