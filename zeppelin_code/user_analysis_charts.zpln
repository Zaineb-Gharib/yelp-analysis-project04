      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\ntop_reviewers = spark.table(\"users\").select(\"name\", \"review_count\").orderBy(\"review_count\", ascending=False).limit(10).toPandas()\n\nplt.figure(figsize=(10, 6))\nplt.barh(top_reviewers['name'], top_reviewers['review_count'], color='#d32323')\nplt.title('Top 10 Reviewers', fontsize=14)\nplt.xlabel('Review Count')\nplt.tight_layout()\nplt.show()\n",
