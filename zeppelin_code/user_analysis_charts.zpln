      "status": "READY"
    },
    {
      "text": "%pyspark\nimport matplotlib.pyplot as plt\nfrom pyspark.sql.functions import year, when, count, col\nimport os\n\n# Create directory for charts\nos.makedirs(\"/data/charts\", exist_ok=True)\n\nprint(\"=\" * 50)\nprint(\"SAVING ALL CHARTS TO /data/charts/\")\nprint(\"=\" * 50)\n\n# ============================================\n# 1. User Growth Chart\n# ============================================\nprint(\"1. Saving User Growth...\")\nuser_growth = spark.table(\"users\").groupBy(year(\"yelping_since\").alias(\"year\")).count().orderBy(\"year\")\ndf = user_growth.toPandas()\n\nplt.figure(figsize=(14, 6))\nbars = plt.bar(df['year'], df['count'], color='#d32323', edgecolor='white')\nfor bar in bars:\n    height = bar.get_height()\n    plt.text(bar.get_x() + bar.get_width()/2., height,\n             f'{int(height):,}', ha='center', va='bottom', fontsize=8, rotation=45)\nplt.title('User Growth Over Time', fontsize=16, fontweight='bold')\nplt.xlabel('Year')\nplt.ylabel('New Users')\nplt.xticks(rotation=45)\nplt.grid(True, alpha=0.3, axis='y')\nplt.tight_layout()\nplt.savefig('/data/charts/user_growth.png', dpi=150, bbox_inches='tight')\nplt.close()\nprint(\"\u2713 Saved: /data/charts/user_growth.png\")\n\n# ============================================\n# 2. Top Reviewers\n# ============================================\nprint(\"2. Saving Top Reviewers...\")\ntop_reviewers = spark.table(\"users\").select(\"name\", \"review_count\").orderBy(\"review_count\", ascending=False).limit(15).toPandas()\n\nplt.figure(figsize=(10, 8))\ncolors = ['#d32323' if i == 0 else '#ff9999' for i in range(len(top_reviewers))]\nplt.barh(top_reviewers['name'], top_reviewers['review_count'], color=colors)\nplt.title('Top 15 Reviewers', fontsize=16, fontweight='bold')\nplt.xlabel('Review Count')\nplt.tight_layout()\nplt.savefig('/data/charts/top_reviewers.png', dpi=150, bbox_inches='tight')\nplt.close()\nprint(\"\u2713 Saved: /data/charts/top_reviewers.png\")\n\n# ============================================\n# 3. Most Popular Users\n# ============================================\nprint(\"3. Saving Most Popular Users...\")\npopular = spark.table(\"users\").select(\"name\", \"fans\").orderBy(\"fans\", ascending=False).limit(15).toPandas()\n\nplt.figure(figsize=(10, 8))\ncolors = ['#d32323' if i == 0 else '#ff9999' for i in range(len(popular))]\nplt.barh(popular['name'], popular['fans'], color=colors)\nplt.title('Top 15 Most Popular Users (by Fans)', fontsize=16, fontweight='bold')\nplt.xlabel('Number of Fans')\nplt.tight_layout()\nplt.savefig('/data/charts/most_popular.png', dpi=150, bbox_inches='tight')\nplt.close()\nprint(\"\u2713 Saved: /data/charts/most_popular.png\")\n\n# ============================================\n# 4. Elite Users Trend\n# ============================================\nprint(\"4. Saving Elite Users Trend...\")\nelite_trend = spark.table(\"users\").groupBy(year(\"yelping_since\").alias(\"year\")).agg(\n    count(\"*\").alias(\"total\"),\n    count(when(col(\"elite\") != \"\", 1)).alias(\"elite\")\n).withColumn(\"elite_pct\", (col(\"elite\") / col(\"total\") * 100)).orderBy(\"year\").toPandas()\n\nplt.figure(figsize=(12, 6))\nplt.plot(elite_trend['year'], elite_trend['elite_pct'], marker='o', color='#d32323', linewidth=2, markersize=8)\nplt.fill_between(elite_trend['year'], elite_trend['elite_pct'], alpha=0.3, color='#d32323')\nplt.title('Elite Users Percentage Trend', fontsize=16, fontweight='bold')\nplt.xlabel('Year')\nplt.ylabel('Elite Users (%)')\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.savefig('/data/charts/elite_trend.png', dpi=150, bbox_inches='tight')\nplt.close()\nprint(\"\u2713 Saved: /data/charts/elite_trend.png\")\n\n# ============================================\n# 5. Rating Distribution\n# ============================================\nprint(\"5. Saving Rating Distribution...\")\nrating_dist = spark.table(\"review\").groupBy(\"stars\").count().orderBy(\"stars\").toPandas()\n\nplt.figure(figsize=(8, 8))\ncolors = ['#ff9999', '#ff6666', '#ff3333', '#cc0000', '#990000']\nplt.pie(rating_dist['count'], labels=rating_dist['stars'], autopct='%1.1f%%', \n        colors=colors, startangle=90, explode=[0.05]*5)\nplt.title('Rating Distribution', fontsize=16, fontweight='bold')\nplt.axis('equal')\nplt.tight_layout()\nplt.savefig('/data/charts/rating_distribution.png', dpi=150, bbox_inches='tight')\nplt.close()\nprint(\"\u2713 Saved: /data/charts/rating_distribution.png\")\n\n# ============================================\n# 6. Adventurous Eaters\n# ============================================\nprint(\"6. Saving Adventurous Eaters...\")\nadventurous = spark.sql(\"\"\"\nSELECT u.name, COUNT(DISTINCT cat.category) as cuisine_count\nFROM users u\nJOIN review r ON u.user_id = r.user_id\nJOIN business b ON r.business_id = b.business_id\nLATERAL VIEW EXPLODE(SPLIT(b.categories, ', ')) cat AS category\nWHERE cat.category IN ('American','Mexican','Italian','Japanese','Chinese','Thai','Mediterranean')\nGROUP BY u.name\nHAVING COUNT(r.review_id) >= 20\nORDER BY cuisine_count DESC\nLIMIT 20\n\"\"\").toPandas()\n\nplt.figure(figsize=(12, 10))\nplt.barh(adventurous['name'], adventurous['cuisine_count'], color='#d32323')\nplt.title('Top 20 Adventurous Eaters (by Cuisine Diversity)', fontsize=16, fontweight='bold')\nplt.xlabel('Number of Cuisines Tried')\nplt.ylabel('User Name')\nplt.tight_layout()\nplt.savefig('/data/charts/adventurous_eaters.png', dpi=150, bbox_inches='tight')\nplt.close()\nprint(\"\u2713 Saved: /data/charts/adventurous_eaters.png\")\n\nprint(\"\\n\" + \"=\" * 50)\nprint(\"\u2705 ALL CHARTS SAVED TO /data/charts/\")\nprint(\"=\" * 50)",
      "user": "anonymous",
