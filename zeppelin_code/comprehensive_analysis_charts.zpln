{
  "paragraphs": [
    {
      "text": "%pyspark\n# Load all data\nbusiness_df \u003d spark.read.json(\"/yelp/data/yelp_academic_dataset_business.json\")\nreview_df \u003d spark.read.json(\"/yelp/data/yelp_academic_dataset_review.json\")\nusers_df \u003d spark.read.json(\"/yelp/data/yelp_academic_dataset_user.json\")\ncheckin_df \u003d spark.read.json(\"/yelp/data/yelp_academic_dataset_checkin.json\")\n\n# Create temp views\nbusiness_df.createOrReplaceTempView(\"business\")\nreview_df.createOrReplaceTempView(\"review\")\nusers_df.createOrReplaceTempView(\"users\")\ncheckin_df.createOrReplaceTempView(\"checkin\")\n\nprint(f\"✅ Businesses: {business_df.count():,}\")\nprint(f\"✅ Reviews: {review_df.count():,}\")\nprint(f\"✅ Users: {users_df.count():,}\")",
      "user": "anonymous",
      "dateUpdated": "2026-03-28 17:32:51.510",
