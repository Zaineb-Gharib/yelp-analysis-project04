    {
      "text": "%pyspark\nfrom pyspark.sql.functions import col, count, when\n\n# Find cursed addresses (2+ failures) - NEED TO USE FULL BUSINESS TABLE\ncursed \u003d business_df.filter(col(\"is_open\") \u003d\u003d 0) \\\n    .groupBy(\"address\", \"city\") \\\n    .agg(count(\"*\").alias(\"failures\")) \\\n    .filter(col(\"failures\") \u003e\u003d 2)\n\nprint(f\"Cursed addresses: {cursed.count():,}\")\n\n# Get cursed addresses list\ncursed_addresses \u003d [row.address for row in cursed.select(\"address\").collect()]\n\n# Filter cursed businesses\ncursed_businesses \u003d business_df.filter(col(\"address\").isin(cursed_addresses))\n\n# Check parking - BusinessParking is a JSON string, need to parse\n# Let\u0027s look at actual values first\nprint(\"Sample BusinessParking values:\")\ncursed_businesses.select(\"attributes.BusinessParking\").show(10)\n\n# Check noise - NoiseLevel values\nprint(\"Sample NoiseLevel values:\")\ncursed_businesses.select(\"attributes.NoiseLevel\").show(10)\n\n# Now count correctly\nparking_count \u003d cursed_businesses.filter(\n    (col(\"attributes.BusinessParking\").isNotNull()) \u0026 \n    (col(\"attributes.BusinessParking\").contains(\"False\"))\n).count()\n\nnoise_count \u003d cursed_businesses.filter(\n    (col(\"attributes.NoiseLevel\").isNotNull()) \u0026 \n    (col(\"attributes.NoiseLevel\") \u003d\u003d \"very_loud\")\n).count()\n\ntotal_cursed \u003d cursed_businesses.count()\n\nprint(f\"\\nTotal cursed businesses: {total_cursed}\")\nprint(f\"No Parking: {parking_count} ({parking_count * 100.0 / total_cursed:.1f}%)\")\nprint(f\"Very Loud: {noise_count} ({noise_count * 100.0 / total_cursed:.1f}%)\")",
      "user": "anonymous",
      "dateUpdated": "2026-03-28 17:43:41.889",
      "progress": 0,
