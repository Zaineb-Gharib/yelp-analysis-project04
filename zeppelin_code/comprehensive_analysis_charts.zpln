      "text": "%pyspark\nfrom pyspark.sql.functions import round as round_func, when\n\n# Calculate conversion rate\nconversion \u003d business_with_checkins.select(\n    col(\"name\"),\n    col(\"review_count\"),\n    col(\"checkin_count\"),\n    round_func(\n        when(col(\"checkin_count\") \u003e 0, \n             col(\"review_count\") * 100.0 / col(\"checkin_count\")\n        ).otherwise(0), 2\n    ).alias(\"conversion_rate\")\n).filter(col(\"checkin_count\") \u003e 0) \\\n .orderBy(col(\"review_count\").desc()) \\\n .limit(20)\n\nprint(\"Review Conversion Rate (Top 20 by review count):\")\nconversion.show(20, truncate\u003dFalse)\n\n",
      "user": "anonymous",
