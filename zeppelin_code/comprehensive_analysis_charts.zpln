    {
      "text": "%pyspark\nfrom pyspark.sql.functions import row_number, desc, col\nfrom pyspark.sql.window import Window\n\n# Filter restaurants with \u003e50 reviews\nrestaurants \u003d business_df.filter(\n    (col(\"review_count\") \u003e 50) \u0026 \n    (col(\"categories\").contains(\"Restaurants\"))\n)\n\n# Rank within each city\nwindow \u003d Window.partitionBy(\"city\").orderBy(desc(\"stars\"), desc(\"review_count\"))\n\n# Get top 5 per city\ntop_merchants \u003d restaurants.withColumn(\"rank\", row_number().over(window)) \\\n    .filter(col(\"rank\") \u003c\u003d 5) \\\n    .select(\"city\", \"name\", \"stars\", \"review_count\", \"rank\")\n\nprint(\"Top 5 Merchants Per City:\")\ntop_merchants.show(50, truncate\u003dFalse)\n\n",
      "user": "anonymous",
      "dateUpdated": "2026-03-28 17:36:43.184",
      "progress": 0,
