    {
      "text": "%pyspark\nfrom pyspark.sql.functions import explode, split, lower, regexp_replace, col\nfrom pyspark.ml.feature import Tokenizer, StopWordsRemover\n\n# Get reviews from cursed addresses\ncursed_business_ids \u003d business_df.filter(col(\"address\").isin(cursed_addresses)).select(\"business_id\")\ncursed_reviews \u003d review_df.join(cursed_business_ids, \"business_id\")\n\n# Take sample for performance (10% of reviews)\nsample_reviews \u003d cursed_reviews.sample(0.1)\n\n# Clean text\nclean_reviews \u003d sample_reviews.select(\n    lower(regexp_replace(col(\"text\"), \"[^a-zA-Z\\\\s]\", \"\")).alias(\"clean_text\")\n)\n\n# Tokenize\ntokenizer \u003d Tokenizer(inputCol\u003d\"clean_text\", outputCol\u003d\"words\")\nwords_df \u003d tokenizer.transform(clean_reviews)\n\n# Remove stop words\nremover \u003d StopWordsRemover(inputCol\u003d\"words\", outputCol\u003d\"filtered\")\nfiltered_df \u003d remover.transform(words_df)\n\n# Count words\nword_counts \u003d filtered_df.select(explode(\"filtered\").alias(\"word\")) \\\n    .groupBy(\"word\") \\\n    .count() \\\n    .orderBy(col(\"count\").desc()) \\\n    .limit(15)\n\nprint(\"Top 15 words in reviews from cursed locations:\")\nword_counts.show(15)\n",
      "user": "anonymous",
      "dateUpdated": "2026-03-28 17:46:02.470",
      "progress": 0,
