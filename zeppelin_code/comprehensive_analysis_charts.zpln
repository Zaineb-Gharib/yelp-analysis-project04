    {
      "text": "%pyspark\nfrom pyspark.sql.functions import log, round as round_func, split, size, col, when\n\n# Calculate check-in counts\ncheckin_count \u003d checkin_df.withColumn(\n    \"checkin_count\", \n    size(split(col(\"date\"), \", \"))\n).select(\"business_id\", \"checkin_count\")\n\n# Join with businesses\nbusiness_with_checkins \u003d business_df.join(checkin_count, \"business_id\", \"left\") \\\n    .fillna({\"checkin_count\": 0})\n\n# Calculate success score\nsuccess_score \u003d business_with_checkins.withColumn(\n    \"success_score\",\n    round_func(\n        col(\"stars\") * 0.4 + \n        log(col(\"review_count\") + 1) * 0.3 + \n        log(col(\"checkin_count\") + 1) * 0.3,\n        2\n    )\n).select(\"name\", \"city\", \"stars\", \"review_count\", \"checkin_count\", \"success_score\") \\\n .orderBy(col(\"success_score\").desc()) \\\n .limit(20)\n\nprint(\"Top 20 Businesses by Success Score:\")\nsuccess_score.show(20, truncate\u003dFalse)\n",
      "user": "anonymous",
      "dateUpdated": "2026-03-28 17:37:24.195",
      "progress": 0,
