      "text": "%pyspark\n# Enhanced version for Question 9\nfrom pyspark.sql.types import ArrayType, StringType\n\n# Define stopwords\nstopwords_bigrams \u003d [\u0027the\u0027, \u0027and\u0027, \u0027for\u0027, \u0027this\u0027, \u0027that\u0027, \u0027with\u0027, \u0027from\u0027, \u0027have\u0027, \n                     \u0027are\u0027, \u0027was\u0027, \u0027were\u0027, \u0027but\u0027, \u0027not\u0027, \u0027all\u0027, \u0027can\u0027, \u0027will\u0027, \n                     \u0027just\u0027, \u0027you\u0027, \u0027your\u0027, \u0027our\u0027, \u0027their\u0027, \u0027very\u0027, \u0027get\u0027, \u0027got\u0027,\n                     \u0027they\u0027, \u0027had\u0027, \u0027there\u0027, \u0027out\u0027, \u0027when\u0027, \u0027would\u0027, \u0027like\u0027, \u0027here\u0027, \n                     \u0027place\u0027, \u0027food\u0027, \u0027one\u0027, \u0027time\u0027, \u0027went\u0027, \u0027came\u0027, \u0027back\u0027, \u0027even\u0027, \n                     \u0027also\u0027, \u0027well\u0027, \u0027ive\u0027, \u0027been\u0027, \u0027could\u0027, \u0027give\u0027, \u0027has\u0027, \u0027last\u0027,\n                     \u0027first\u0027, \u0027ever\u0027, \u0027night\u0027, \u0027star\u0027, \u0027dont\u0027, \u0027didnt\u0027, \u0027said\u0027, \u0027more\u0027]\n\ndef get_pain_point_bigrams(text):\n    if not text:\n        return []\n    words \u003d text.lower().split()\n    # Clean words\n    words \u003d [\u0027\u0027.join(c for c in w if c.isalpha()) for w in words]\n    # Filter out stopwords\n    words \u003d [w for w in words if len(w) \u003e 2 and w not in stopwords_bigrams]\n    \n    # Create bigrams\n    bigrams \u003d []\n    for i in range(len(words)-1):\n        bigram \u003d f\"{words[i]} {words[i+1]}\"\n        bigrams.append(bigram)\n    \n    return bigrams[:20]\n\nbigram_udf \u003d udf(get_pain_point_bigrams, ArrayType(StringType()))\n\n# Get all bigrams from 1-2 star reviews\nall_bigrams \u003d review_df.filter(col(\"stars\") \u003c\u003d 2) \\\n  .select(explode(bigram_udf(col(\"text\"))).alias(\"bigram\")) \\\n  .groupBy(\"bigram\") \\\n  .count() \\\n  .orderBy(col(\"count\").desc()) \\\n  .limit(100) \\\n  .toPandas()\n\n# Define neutral/common bigrams to exclude\nneutral_bigrams \u003d [\u0027first time\u0027, \u0027ive been\u0027, \u0027could give\u0027, \u0027came here\u0027, \n                   \u0027went here\u0027, \u0027ive ever\u0027, \u0027been here\u0027, \u0027went there\u0027, \n                   \u0027has been\u0027, \u0027place has\u0027, \u0027give place\u0027, \u0027one star\u0027, \n                   \u0027last night\u0027, \u0027customer service\u0027, \u0027good service\u0027, \n                   \u0027food was\u0027, \u0027place was\u0027, \u0027time time\u0027, \u0027would like\u0027]\n\n# Filter to get pain point bigrams\npain_bigrams \u003d all_bigrams[~all_bigrams[\u0027bigram\u0027].isin(neutral_bigrams)].head(15)\n\nprint(\"\u003d\"*60)\nprint(\"QUESTION 9: Top 15 Pain Point Bigrams for 1-2 Star Reviews\")\nprint(\"\u003d\"*60)\nprint(pain_bigrams.to_string(index\u003dFalse))\n\n# Create bar chart\nif len(pain_bigrams) \u003e 0:\n    plt.figure(figsize\u003d(10, 8))\n    plt.barh(pain_bigrams[\u0027bigram\u0027][::-1], pain_bigrams[\u0027count\u0027][::-1], \n             color\u003d\u0027orange\u0027, edgecolor\u003d\u0027black\u0027, alpha\u003d0.8)\n    plt.xlabel(\u0027Frequency\u0027)\n    plt.ylabel(\u0027Pain Point Bigrams\u0027)\n    plt.title(\u0027QUESTION 9: Top 15 Pain Points in 1-2 Star Reviews\u0027)\n    \n    biggest \u003d pain_bigrams[\u0027count\u0027].max()\n    for i, (bigram, count) in enumerate(zip(pain_bigrams[\u0027bigram\u0027][::-1], pain_bigrams[\u0027count\u0027][::-1])):\n        plt.text(count + biggest*0.01, i, f\u0027{count:,}\u0027, va\u003d\u0027center\u0027, fontsize\u003d9)\n    \n    plt.tight_layout()\n    plt.show()\nelse:\n    print(\"No pain point bigrams found\")\n",
