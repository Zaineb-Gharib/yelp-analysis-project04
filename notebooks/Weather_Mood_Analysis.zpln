"jobUrl":"http://172.16.193.135:4040/jobs/job?id=31"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774429226001_1795073164","id":"paragraph_1774429226001_1795073164","dateCreated":"2026-03-25T17:00:26+0800","dateStarted":"2026-03-25T17:02:06+0800","dateFinished":"2026-03-25T17:02:07+0800","status":"FINISHED"},{"text":"%pyspark\nbusiness_small = spark.sql(\"\"\"\nSELECT business_id, city\nFROM business\nWHERE city IN (\n    'Philadelphia','Tampa','Indianapolis','Nashville','Tucson',\n    'New Orleans','St. Petersburg','Reno','Santa Barbara','Boise','St. Louis'\n)\n\"\"\")\n\nbusiness_small.show(20, False)\nprint(\"count =\", business_small.count())","user":"anonymous","dateUpdated":"2026-03-25T17:13:20+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----------------------+--------------+\n|business_id           |city          |\n+----------------------+--------------+\n|Pns2l4eNsfO8kk83dixA6A|Santa Barbara |\n|tUFrWirKiKi_TAnsVWINQQ|Tucson        |\n|MTSW4McQd7CbVtyjqoe9mw|Philadelphia  |\n|qkRM_2X51Yqxk3btlwAQIg|St. Petersburg|\n|bBDDEgkFA1Otx9Lfe7BZUQ|Nashville     |\n|il_Ro8jwPlHresjw9EGmBg|Indianapolis  |\n|MUTTqe8uqyMdBl186RmNeA|Philadelphia  |\n|rBmpy_Y1UbBx8ggHlyb7hA|Tucson        |\n|M0XSSHqrASOnhgbWDJIpQA|New Orleans   |\n|ROeacJQwBeh05Rqg7F6TCg|Philadelphia  |\n|qhDdDeI3K4jy2KyzwFN53w|Indianapolis  |\n|kfNv-JZpuN6TVNSO6hHdkw|Indianapolis  |\n|9OG5YkX1g2GReZM0AskizA|Reno          |\n|4iRzR7OaS-QaSXuvYxEGKA|Nashville     |\n|noByYNtDLQAra9ccqxdfDw|Santa Barbara |\n|tMkwHmWFUEXrC9ZduonpTg|Nashville     |\n|QdN72BWoyFypdGJhhI5r7g|Philadelphia  |\n|fvWn8oXXwbj2l79cochZyw|Boise         |\n|Mjboz24M9NlBeiOJKLEd_Q|Philadelphia  |\n|w_AMNoI1iG9eay7ncmc67w|New Orleans   |\n+----------------------+--------------+\nonly showing top 20 rows\n\ncount = 68730\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=0"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=1"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=2"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774429385260_1618092900","id":"paragraph_1774429385260_1618092900","dateCreated":"2026-03-25T17:03:05+0800","dateStarted":"2026-03-25T17:13:20+0800","dateFinished":"2026-03-25T17:13:25+0800","status":"FINISHED"},{"text":"%pyspark\nbusiness_small = business_small.distinct().cache()\nprint(\"cached count =\", business_small.count())","user":"anonymous","dateUpdated":"2026-03-25T17:16:44+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"cached count = 68730\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=3"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=4"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=5"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=6"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774429573031_1202276338","id":"paragraph_1774429573031_1202276338","dateCreated":"2026-03-25T17:06:13+0800","dateStarted":"2026-03-25T17:16:44+0800","dateFinished":"2026-03-25T17:16:50+0800","status":"FINISHED"},{"text":"%pyspark\n# Load Yelp reviews from 2017-2022 and keep only reviews for businesses in the selected target cities\n# Filter reviews to 2017-2022 and join with selected-city businesses\nreviews_small = spark.sql(\"\"\"\nSELECT \n    rev_business_id as business_id,\n    rev_stars as stars,\n    rev_date as date\nFROM review\nWHERE rev_date >= '2017-01-01' AND rev_date <= '2022-12-31'\n\"\"\")\n\nreviews_small = reviews_small.join(\n    business_small,\n    on=\"business_id\",\n    how=\"inner\"\n)\n\nreviews_small.show(10, False)\n","user":"anonymous","dateUpdated":"2026-03-26T14:02:01+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----------------------+-----+----------+-------------+\n|business_id           |stars|date      |city         |\n+----------------------+-----+----------+-------------+\n|e4Vwtrqf-wpJfwesgvdgxQ|4    |2017-01-14|New Orleans  |\n|cPepkJeRMtHapc_b2Oe_dw|4    |2018-07-17|Indianapolis |\n|X8lfGPagfLzfOsx0k08NRQ|5    |2017-05-13|Reno         |\n|PY9GRfzr4nTZeINf346QOw|4    |2017-09-20|Reno         |\n|kq5Ghhh14r-eCxlVmlyd8w|5    |2018-08-23|Philadelphia |\n|Zx7n8mdt8OzLRXVzolXNhQ|5    |2018-04-27|Nashville    |\n|A2q7d-CBM2-81tVkmS4JMw|2    |2017-07-08|Reno         |\n|I6L0Zxi5Ww0zEWSAVgngeQ|4    |2018-07-07|New Orleans  |\n|qO9dNNIvNbCBd8ZgjxMxgQ|5    |2017-04-08|Santa Barbara|\n|HTqXI5S2XcSlh_ylx9sE6g|5    |2018-03-23|Philadelphia |\n+----------------------+-----+----------+-------------+\nonly showing top 10 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=9"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=10"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774430440852_14224129","id":"paragraph_1774430440852_14224129","dateCreated":"2026-03-25T17:20:40+0800","dateStarted":"2026-03-25T17:25:34+0800","dateFinished":"2026-03-25T17:25:37+0800","status":"FINISHED"},{"text":"%pyspark\n# Quick check: sample 1000 reviews, then count by city\nreviews_sample = reviews_small.limit(1000)\nreviews_sample.groupBy(\"city\").count().show()","user":"anonymous","dateUpdated":"2026-03-25T17:58:50+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------+-----+\n|          city|count|\n+--------------+-----+\n|   New Orleans|  188|\n|  Indianapolis|   82|\n|          Reno|   95|\n|  Philadelphia|  206|\n|     Nashville|  126|\n| Santa Barbara|   67|\n|         Tampa|  101|\n|         Boise|   27|\n|        Tucson|   86|\n|     St. Louis|   14|\n|St. Petersburg|    8|\n+--------------+-----+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=11"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=12"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=13"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774430734637_505400542","id":"paragraph_1774430734637_505400542","dateCreated":"2026-03-25T17:25:34+0800","dateStarted":"2026-03-25T17:58:50+0800","dateFinished":"2026-03-25T17:58:55+0800","status":"FINISHED"},{"text":"%pyspark\n# Compute average rating per city\n\nreviews_small.groupBy(\"city\").avg(\"stars\").show()\n","user":"anonymous","dateUpdated":"2026-03-25T18:03:31+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------+------------------+\n|          city|        avg(stars)|\n+--------------+------------------+\n|  Philadelphia|3.8265834695431593|\n|  Indianapolis|3.8560786012481376|\n|     Nashville| 3.838138355805684|\n|         Boise|3.8147891658971993|\n|     St. Louis|3.8265354383910273|\n|         Tampa|3.7615318968912748|\n|          Reno|3.7709960679632624|\n|   New Orleans| 4.006808729108539|\n|St. Petersburg| 3.916485832971666|\n|        Tucson|3.6946098043526048|\n| Santa Barbara| 4.064528075490145|\n+--------------+------------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=14"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=15"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=16"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774432730624_103213416","id":"paragraph_1774432730624_103213416","dateCreated":"2026-03-25T17:58:50+0800","dateStarted":"2026-03-25T18:03:31+0800","dateFinished":"2026-03-25T18:03:46+0800","status":"FINISHED"},{"text":"%pyspark\n# Build and save the filtered review-city dataset as a table\nreviews_small = spark.sql(\"\"\"\nSELECT \n    r.rev_business_id as business_id,\n    r.rev_stars as stars,\n    r.rev_date as date,\n    b.city\nFROM review r\nJOIN business b\nON r.rev_business_id = b.business_id\nWHERE r.rev_date >= '2017-01-01'\n  AND r.rev_date <= '2022-12-31'\n  AND b.city IN (\n    'Philadelphia','Tampa','Indianapolis','Nashville','Tucson',\n    'New Orleans','St. Petersburg','Reno','Santa Barbara','Boise','St. Louis'\n  )\n\"\"\")\n\nreviews_small.write.mode(\"overwrite\").saveAsTable(\"reviews_small_tbl\")\n\nspark.sql(\"SELECT * FROM reviews_small_tbl LIMIT 10\").show(truncate=False)","user":"anonymous","dateUpdated":"2026-03-25T18:13:47+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----------------------+-----+----------+------------+\n|business_id           |stars|date      |city        |\n+----------------------+-----+----------+------------+\n|bQ_R0bLvTWS4jHsF66MnZg|2    |2018-02-22|Tampa       |\n|b54tS94cq0r0STDEUge4GA|5    |2018-12-07|Reno        |\n|yqq1Fvt7WtduIO3GwjCP1Q|1    |2018-03-15|Nashville   |\n|S27cRb1jq0Q7QUYqEp7VGA|4    |2019-02-01|Reno        |\n|W6k6b-bUaX0goySzl-zgTg|5    |2019-07-15|Philadelphia|\n|W6k6b-bUaX0goySzl-zgTg|5    |2017-06-05|Philadelphia|\n|18zXpz-yBCLHDH3de3_reg|4    |2019-04-27|St. Louis   |\n|S27cRb1jq0Q7QUYqEp7VGA|5    |2019-05-22|Reno        |\n|Q1wTWAhOaoOZQRiGeL6N7g|4    |2017-01-09|Nashville   |\n|C9KvsTqi617Yg_sNjG2UDA|5    |2019-03-03|Nashville   |\n+----------------------+-----+----------+------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=21"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=22"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=23"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=24"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=25"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774433351147_1098957373","id":"paragraph_1774433351147_1098957373","dateCreated":"2026-03-25T18:09:11+0800","dateStarted":"2026-03-25T18:13:47+0800","dateFinished":"2026-03-25T18:14:06+0800","status":"FINISHED"},{"text":"%pyspark\n# Join saved reviews and weather tables on city and date\nfinal_df = spark.sql(\"\"\"\nSELECT\n    r.business_id,\n    r.stars,\n    r.date,\n    r.city,\n    w.precip_in,\n    w.temp_max_f,\n    w.temp_min_f,\n    w.wind_mph,\n    w.rain_flag,\n    w.heavy_rain_flag,\n    w.strong_wind_flag,\n    w.extreme_heat_flag\nFROM reviews_small_tbl r\nJOIN weather_final_tbl w\nON r.city = w.city\nAND r.date = w.date\n\"\"\")\n\nfinal_df.show(10, False)","user":"anonymous","dateUpdated":"2026-03-25T18:15:22+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----------------------+-----+----------+------------+---------+----------+----------+--------+---------+---------------+----------------+-----------------+\n|business_id           |stars|date      |city        |precip_in|temp_max_f|temp_min_f|wind_mph|rain_flag|heavy_rain_flag|strong_wind_flag|extreme_heat_flag|\n+----------------------+-----+----------+------------+---------+----------+----------+--------+---------+---------------+----------------+-----------------+\n|bQ_R0bLvTWS4jHsF66MnZg|2    |2018-02-22|Tampa       |0.0      |87        |68        |6.93    |0        |0              |0               |0                |\n|b54tS94cq0r0STDEUge4GA|5    |2018-12-07|Reno        |0.0      |36        |31        |3.13    |0        |0              |0               |0                |\n|yqq1Fvt7WtduIO3GwjCP1Q|1    |2018-03-15|Nashville   |0.0      |72        |41        |8.72    |0        |0              |0               |0                |\n|S27cRb1jq0Q7QUYqEp7VGA|4    |2019-02-01|Reno        |0.0      |53        |33        |2.46    |0        |0              |0               |0                |\n|W6k6b-bUaX0goySzl-zgTg|5    |2019-07-15|Philadelphia|0.0      |87        |70        |7.61    |0        |0              |0               |0                |\n|W6k6b-bUaX0goySzl-zgTg|5    |2017-06-05|Philadelphia|0.02     |74        |64        |3.8     |0        |0              |0               |0                |\n|18zXpz-yBCLHDH3de3_reg|4    |2019-04-27|St. Louis   |