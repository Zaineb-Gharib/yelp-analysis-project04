:42:11, 2014-04-28 21:04:46, 2014-09-30 14:41:47, 2014-10-23 18:22:28, 2015-04-27 19:55:00, 2015-09-21 12:52:09, 2015-10-01 12:46:16, 2015-10-22 13:35:04, 2016-01-14 12:27:43, 2016-02-01 15:15:07, 2016-02-11 12:22:47, 2016-03-31 23:15:46, 2016-04-11 13:11:34, 2016-05-25 12:44:11, 2016-06-27 15:46:11, 2016-06-30 15:14:28, 2016-07-28 14:15:59, 2016-09-22 20:05:06, 2016-11-16 19:00:11, 2016-12-27 14:36:14, 2017-01-24 20:18:16, 2017-02-21 16:01:49, 2017-03-21 14:08:44, 2017-05-21 16:07:21, 2017-08-07 14:17:39, 2021-06-21 19:59:50|\n+----------------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+\nonly showing top 5 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=67"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774438309400_332333188","id":"paragraph_1774438309400_332333188","dateCreated":"2026-03-25T19:31:49+0800","dateStarted":"2026-03-25T19:35:17+0800","dateFinished":"2026-03-25T19:35:18+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\n# Split comma-separated check-in timestamps into one row per timestamp\ncheckin_exploded = checkin_df.withColumn(\n    \"checkin_time\",\n    F.explode(F.split(F.col(\"checkin_dates\"), \",\"))\n)\n\ncheckin_exploded.select(\"business_id\", \"checkin_time\").show(10, False)","user":"anonymous","dateUpdated":"2026-03-25T19:45:36+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----------------------+--------------------+\n|business_id           |checkin_time        |\n+----------------------+--------------------+\n|---kPU91CF4Lq2-WlRu9Lw|2020-03-13 21:10:56 |\n|---kPU91CF4Lq2-WlRu9Lw| 2020-06-02 22:18:06|\n|---kPU91CF4Lq2-WlRu9Lw| 2020-07-24 22:42:27|\n|---kPU91CF4Lq2-WlRu9Lw| 2020-10-24 21:36:13|\n|---kPU91CF4Lq2-WlRu9Lw| 2020-12-09 21:23:33|\n|---kPU91CF4Lq2-WlRu9Lw| 2021-01-20 17:34:57|\n|---kPU91CF4Lq2-WlRu9Lw| 2021-04-30 21:02:03|\n|---kPU91CF4Lq2-WlRu9Lw| 2021-05-25 21:16:54|\n|---kPU91CF4Lq2-WlRu9Lw| 2021-08-06 21:08:08|\n|---kPU91CF4Lq2-WlRu9Lw| 2021-10-02 15:15:42|\n+----------------------+--------------------+\nonly showing top 10 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=68"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774438517723_989259586","id":"paragraph_1774438517723_989259586","dateCreated":"2026-03-25T19:35:17+0800","dateStarted":"2026-03-25T19:45:36+0800","dateFinished":"2026-03-25T19:45:36+0800","status":"FINISHED"},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\n# Clean spaces and convert to timestamp\ncheckin_clean = checkin_exploded.withColumn(\n    \"checkin_time_clean\",\n    F.trim(F.col(\"checkin_time\"))\n).withColumn(\n    \"timestamp\",\n    F.to_timestamp(F.col(\"checkin_time_clean\"), \"yyyy-MM-dd HH:mm:ss\")\n).withColumn(\n    \"date\",\n    F.to_date(F.col(\"timestamp\"))\n)\n\n# Filter to required years (2017–2022)\ncheckin_filtered = checkin_clean.filter(\n    (F.col(\"date\") >= \"2017-01-01\") &\n    (F.col(\"date\") <= \"2022-12-31\")\n)\n\ncheckin_filtered.select(\"business_id\", \"date\").show(10, False)","user":"anonymous","dateUpdated":"2026-03-25T19:49:28+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----------------------+----------+\n|business_id           |date      |\n+----------------------+----------+\n|---kPU91CF4Lq2-WlRu9Lw|2020-03-13|\n|---kPU91CF4Lq2-WlRu9Lw|2020-06-02|\n|---kPU91CF4Lq2-WlRu9Lw|2020-07-24|\n|---kPU91CF4Lq2-WlRu9Lw|2020-10-24|\n|---kPU91CF4Lq2-WlRu9Lw|2020-12-09|\n|---kPU91CF4Lq2-WlRu9Lw|2021-01-20|\n|---kPU91CF4Lq2-WlRu9Lw|2021-04-30|\n|---kPU91CF4Lq2-WlRu9Lw|2021-05-25|\n|---kPU91CF4Lq2-WlRu9Lw|2021-08-06|\n|---kPU91CF4Lq2-WlRu9Lw|2021-10-02|\n+----------------------+----------+\nonly showing top 10 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=69"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774439136073_993173661","id":"paragraph_1774439136073_993173661","dateCreated":"2026-03-25T19:45:36+0800","dateStarted":"2026-03-25T19:49:28+0800","dateFinished":"2026-03-25T19:49:31+0800","status":"FINISHED"},{"text":"%pyspark\n# Check the minimum and maximum dates in filtered check-ins\ncheckin_filtered.agg(\n    F.min(\"date\").alias(\"min_date\"),\n    F.max(\"date\").alias(\"max_date\")\n).show()","user":"anonymous","dateUpdated":"2026-03-25T19:51:43+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----------+----------+\n|  min_date|  max_date|\n+----------+----------+\n|2017-01-01|2022-01-19|\n+----------+----------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=70"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=71"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774439368408_242811049","id":"paragraph_1774439368408_242811049","dateCreated":"2026-03-25T19:49:28+0800","dateStarted":"2026-03-25T19:51:43+0800","dateFinished":"2026-03-25T19:51:55+0800","status":"FINISHED"},{"text":"%pyspark\n# Add city to each check-in using the business table\ncheckin_with_city = checkin_filtered.join(\n    spark.table(\"business\").select(\"business_id\", \"city\"),\n    on=\"business_id\",\n    how=\"inner\"\n)\n\ncheckin_with_city.select(\"business_id\", \"date\", \"city\").show(10, False)","user":"anonymous","dateUpdated":"2026-03-25T19:55:46+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+----------------------+----------+----+\n|business_id           |date      |city|\n+----------------------+----------+----+\n|-0iIxySkp97WNlwK66OGWg|2017-01-08|Reno|\n|-0iIxySkp97WNlwK66OGWg|2017-01-12|Reno|\n|-0iIxySkp97WNlwK66OGWg|2017-01-14|Reno|\n|-0iIxySkp97WNlwK66OGWg|2017-01-29|Reno|\n|-0iIxySkp97WNlwK66OGWg|2017-02-01|Reno|\n|-0iIxySkp97WNlwK66OGWg|2017-02-09|Reno|\n|-0iIxySkp97WNlwK66OGWg|2017-02-18|Reno|\n|-0iIxySkp97WNlwK66OGWg|2017-02-18|Reno|\n|-0iIxySkp97WNlwK66OGWg|2017-02-25|Reno|\n|-0iIxySkp97WNlwK66OGWg|2017-02-25|Reno|\n+----------------------+----------+----+\nonly showing top 10 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=72"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=73"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=74"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=75"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774439503274_855703133","id":"paragraph_1774439503274_855703133","dateCreated":"2026-03-25T19:51:43+0800","dateStarted":"2026-03-25T19:55:46+0800","dateFinished":"2026-03-25T19:55:59+0800","status":"FINISHED"},{"text":"%pyspark\n# Verify that check-ins now contain only the 11 target cities\ncheckin_target.select(\"city\").distinct().orderBy(\"city\").show(20, False)\n","user":"anonymous","dateUpdated":"2026-03-25T20:00:46+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------+\n|city          |\n+--------------+\n|Boise         |\n|Indianapolis  |\n|Nashville     |\n|New Orleans   |\n|Philadelphia  |\n|Reno          |\n|Santa Barbara |\n|St. Louis     |\n|St. Petersburg|\n|Tampa         |\n|Tucson        |\n+--------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=80"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=81"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=82"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=83"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=84"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774439746924_1276377665","id":"paragraph_1774439746924_1276377665","dateCreated":"2026-03-25T19:55:46+0800","dateStarted":"2026-03-25T20:00:46+0800","dateFinished":"2026-03-25T20:00:58+0800","status":"FINISHED"},{"text":"%pyspark\n# Count total check-ins for each city on each date\ndaily_checkins = checkin_target.groupBy(\"city\", \"date\").count() \\\n    .withColumnRenamed(\"count\", \"daily_checkin_count\")\n\ndaily_checkins.show(10, False)","user":"anonymous","dateUpdated":"2026-03-25T20:03:45+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+------------+----------+-------------------+\n|city        |date      |daily_checkin_count|\n+------------+----------+-------------------+\n|Indianapolis|2019-01-15|97                 |\n|New Orleans |2019-09-13|307                |\n|Nashville   |2017-08-06|302                |\n|St. Louis   |2017-08-02|33                 |\n|Philadelphia|2017-04-01|874                |\n|Philadelphia|2017-06-24|803                |\n|Philadelphia|2017-07-01|742                |\n|Philadelphia|2018-03-06|335                |\n|Nashville   |2017-01-15|385                |\n|Nashville   |2017-09-16|279                |\n+------------+----------+-------------------+\nonly showing top 10 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=85"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=86"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=87"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=88"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=89"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774439884972_1863282217","id":"paragraph_1774439884972_1863282217","dateCreated":"2026-03-25T19:58:04+0800","dateStarted":"2026-03-25T20:03:45+0800","dateFinished":"2026-03-25T20:03:59+0800","status":"FINISHED"},{"text":"%pyspark\n# Load the saved weather table as a DataFrame\nweather_check = spark.table(\"weather_final_tbl\")\n\nweather_check.show(5, False)","user":"anonymous","dateUpdated":"2026-03-25T20:15:38+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+------------+----------+---------+----------+----------+--------+---------+---------------+----------------+-----------------+\n|city        |date      |precip_in|temp_max_f|temp_min_f|wind_mph|rain_flag|heavy_rain_flag|strong_wind_flag|extreme_heat_flag|\n+------------+----------+---------+----------+----------+--------+---------+---------------+----------------+-----------------+\n|Philadelphia|2017-01-01|0.0      |51        |33        |8.72    |0        |0              |0               |0                |\n|Philadelphia|2017-01-02|0.4      |43        |32        |9.17    |1        |0              |0               |0                |\n|Philadelphia|2017-01-03|0.32     |48        |41        |9.84    |1        |0              |0               |0                |\n|Philadelphia|2017-01-04|0.01     |54        |35        |14.32   |0        |0              |0               |0                |\n|Philadelphia|2017-01-05|0.02     |35        |28        |9.62    |0        |0              |0               |0                |\n+------------+----------+---------+----------+----------+--------+---------+---------------+----------------+-----------------+\nonly showing top 5 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=90"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774440225504_77680491","id":"paragraph_1774440225504_77680491","dateCreated":"2026-03-25T20:03:45+0800","dateStarted":"2026-03-25T20:15:38+0800","dateFinished":"2026-03-25T20:15:39+0800","status":"FINISHED"},{"text":"%pyspark\n# Join daily check-in activity with daily weather using city and date\ncheckin_weather = daily_checkins.join(\n    weather_check,\n    on=[\"city\", \"date\"],\n    how=\"inner\"\n)\n\ncheckin_weather.show(10, False)","user":"anonymous","dateUpdated":"2026-03-25T20:18:03+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+------------+----------+-------------------+---------+----------+----------+--------+---------+---------------+----------------+-----------------+\n|city        |date      |daily_checkin_count|precip_in|temp_max_f|temp_min_f|wind_mph|rain_flag|heavy_rain_flag|strong_wind_flag|extreme_heat_flag|\n+------------+----------+-------------------+---------+----------+----------+--------+---------+---------------+----------------+-----------------+\n|Indianapolis|2019-01-15|97                 |0.0      |32        |21        |12.53   |0        |0              |0               |0                |\n|New Orleans |2019-09-13|307                |0.0      |98        |77        |5.82    |0        |0              |0               |1                |\n|Nashville   |2017-08-06|302                |0.98     |91        |65        |7.16    |1        |1              |0               |0                |\n|St. Louis   |2017-08-02|33                 |0.0      |90        |71        |5.82    |0        |0              |0               |0                |\n|Philadelphia|2017-04-01|874                |0.0      |53        |39        |13.