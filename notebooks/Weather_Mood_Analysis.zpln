torSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------+---------+------+\n|category_group|rain_flag|count |\n+--------------+---------+------+\n|Bakeries      |0        |42801 |\n|Bakeries      |1        |6782  |\n|Coffee & Tea  |0        |243021|\n|Coffee & Tea  |1        |37762 |\n|Cold Treats   |0        |38118 |\n|Cold Treats   |1        |5426  |\n|Fast Food     |0        |73764 |\n|Fast Food     |1        |10528 |\n|Pizza         |0        |101555|\n|Pizza         |1        |15958 |\n|Soup          |0        |38688 |\n|Soup          |1        |5459  |\n+--------------+---------+------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=49"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=50"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=51"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=52"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=53"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=54"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774458187403_370768515","id":"paragraph_1774458187403_370768515","dateCreated":"2026-03-26T01:03:07+0800","dateStarted":"2026-03-26T01:03:19+0800","dateFinished":"2026-03-26T01:03:25+0800","status":"FINISHED"},{"text":"%pyspark\n#This creates:\n\n#check-ins per day\n#per category\n#per weather condition\ncategory_day = checkin_weather.groupBy(\n    \"city\", \"date\", \"category_group\", \"rain_flag\"\n).count().withColumnRenamed(\"count\", \"daily_checkins\")","user":"anonymous","dateUpdated":"2026-03-26T01:12:57+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774458199750_656566207","id":"paragraph_1774458199750_656566207","dateCreated":"2026-03-26T01:03:19+0800","dateStarted":"2026-03-26T01:12:19+0800","dateFinished":"2026-03-26T01:12:19+0800","status":"FINISHED"},{"text":"%pyspark\n\nrain_avg = category_day.groupBy(\"category_group\", \"rain_flag\") \\\n    .avg(\"daily_checkins\") \\\n    .withColumnRenamed(\"avg(daily_checkins)\", \"avg_daily_checkins\")","user":"anonymous","dateUpdated":"2026-03-26T01:12:35+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774458739739_331376296","id":"paragraph_1774458739739_331376296","dateCreated":"2026-03-26T01:12:19+0800","dateStarted":"2026-03-26T01:12:35+0800","dateFinished":"2026-03-26T01:12:35+0800","status":"FINISHED"},{"text":"%pyspark\nrain_avg.orderBy(\"category_group\", \"rain_flag\").show(50, False)","user":"anonymous","dateUpdated":"2026-03-26T01:14:02+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------+---------+------------------+\n|category_group|rain_flag|avg_daily_checkins|\n+--------------+---------+------------------+\n|Bakeries      |0        |3.461743772241993 |\n|Bakeries      |1        |3.714129244249726 |\n|Coffee & Tea  |0        |14.387602865431294|\n|Coffee & Tea  |1        |15.662380754873496|\n|Cold Treats   |0        |3.271931330472103 |\n|Cold Treats   |1        |3.2413381123058542|\n|Fast Food     |0        |4.975313638203157 |\n|Fast Food     |1        |4.996677740863787 |\n|Pizza         |0        |6.630214794019716 |\n|Pizza         |1        |7.263541192535276 |\n|Soup          |0        |3.358624880631999 |\n|Soup          |1        |3.241686460807601 |\n+--------------+---------+------------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=55"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=56"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=57"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=58"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=59"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=60"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=61"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774458755199_1192329995","id":"paragraph_1774458755199_1192329995","dateCreated":"2026-03-26T01:12:35+0800","dateStarted":"2026-03-26T01:14:02+0800","dateFinished":"2026-03-26T01:14:10+0800","status":"FINISHED"},{"text":"%pyspark\n# Business Insight:\n# Rainy weather shifts customer behavior toward delivery-oriented consumption,\n# reflected by sustained or increased check-ins in pizza and coffee categories.\n# This suggests customers prefer convenient and comfort food rather than dining out.\n\n# Cold treats and some categories decline during rain, indicating reduced interest in cold or non-essential items.\n\n# Extreme heat shifts consumption away from hot beverages toward cold items,\n# while fast food remains stable across conditions.\n\n# Restaurants should adjust inventory (e.g., pizza ingredients, coffee, cold desserts)\n# and increase delivery staffing during adverse weather conditions to meet demand.","user":"anonymous","dateUpdated":"2026-03-26T08:34:30+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774458842482_507411507","id":"paragraph_1774458842482_507411507","dateCreated":"2026-03-26T01:14:02+0800","status":"READY"},{"text":"%pyspark\nimport matplotlib.pyplot as plt\n\n# Convert small aggregated data to pandas (SAFE: small dataset)\npdf = rain_chart.toPandas()\n\n# Pivot for better visualization\npivot_df = pdf.pivot(index=\"category_group\", columns=\"rain_flag\", values=\"avg_daily_checkins\")\n\n# Plot\npivot_df.plot(kind=\"bar\")\n\nplt.title(\"Average Daily Check-ins by Category (Rain vs No Rain)\")\nplt.xlabel(\"Category\")\nplt.ylabel(\"Avg Daily Check-ins\")\nplt.xticks(rotation=45)\nplt.legend([\"No Rain (0)\", \"Rain (1)\"])\n\nplt.show()","user":"anonymous","dateUpdated":"2026-03-26T08:43:31+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=69"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=70"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=71"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=72"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=73"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=74"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=75"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=76"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=77"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774485626715_888793903","id":"paragraph_1774485626715_888793903","dateCreated":"2026-03-26T08:40:26+0800","dateStarted":"2026-03-26T08:43:31+0800","dateFinished":"2026-03-26T08:43:43+0800","status":"FINISHED"},{"text":"%pyspark\nimport matplotlib.pyplot as plt\n\npdf = rain_chart.toPandas()\n\npivot_df = pdf.pivot(index=\"category_group\", columns=\"rain_flag\", values=\"avg_daily_checkins\")\n\n# Calculate difference\npivot_df[\"difference\"] = pivot_df[1] - pivot_df[0]\n\npivot_df[\"difference\"].plot(kind=\"bar\")\n\nplt.title(\"Change in Demand Due to Rain\")\nplt.xlabel(\"Category\")\nplt.ylabel(\"Increase / Decrease\")\nplt.xticks(rotation=45)\n\nplt.axhline(0)  # baseline\nplt.show()","user":"anonymous","dateUpdated":"2026-03-26T08:45:56+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=80"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774485633477_1513273107","id":"paragraph_1774485633477_1513273107","dateCreated":"2026-03-26T08:40:33+0800","dateStarted":"2026-03-26T08:45:56+0800","dateFinished":"2026-03-26T08:45:57+0800","status":"FINISHED"},{"text":"%python\nimport matplotlib.pyplot as plt\nimport numpy as np\n\ncategories = [\"Bakeries\", \"Coffee & Tea\", \"Cold Treats\", \"Fast Food\", \"Pizza\", \"Soup\"]\n\nnormal = [46770, 263666, 40489, 77144, 108697, 40776]\nheat   = [2813, 17117, 3055, 7148, 8816, 3371]\n\nx = np.arange(len(categories))\nwidth = 0.35\n\nplt.figure(figsize=(10,5))\n\nplt.bar(x - width/2, normal, width, label=\"Normal Weather\")\nplt.bar(x + width/2, heat, width, label=\"Extreme Heat\")\n\nplt.xticks(x, categories, rotation=30)\nplt.ylabel(\"Total Check-ins\")\nplt.title(\"Impact of Extreme Heat on Food Demand\")\nplt.legend()\n\nplt.tight_layout()\nplt.show()","user":"anonymous","dateUpdated":"2026-03-26T14:54:53+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774486622443_1052330777","id":"paragraph_1774486622443_1052330777","dateCreated":"2026-03-26T08:57:02+0800","dateStarted":"2026-03-26T14:54:53+0800","dateFinished":"2026-03-26T14:54:54+0800","status":"FINISHED"},{"text":"%python\nimport matplotlib.pyplot as plt\nimport numpy as np\n\ncategories = [\"Bakeries\", \"Coffee & Tea\", \"Cold Treats\", \"Fast Food\", \"Pizza\", \"Soup\"]\n\nnormal = np.array([46770, 263666, 40489, 77144, 108697, 40776])\nheat   = np.array([2813, 17117, 3055, 7148, 8816, 3371])\n\n# Calculate percentage change\nchange = ((heat - normal) / normal) * 100\n\nplt.figure(figsize=(10,5))\nplt.bar(categories, change)\n\nplt.axhline(0)  # baseline\nplt.ylabel(\"Percentage Change (%)\")\nplt.title(\"Percentage Change in Demand During Extreme Heat\")\nplt.xticks(rotation=30)\n\nplt.tight_layout()\nplt.show()","user":"anonymous","dateUpdated":"2026-03-26T14:56:34+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774486911572_2030988495","id":"paragraph_1774486911572_2030988495","dateCreated":"2026-03-26T09:01:51+0800","dateStarted":"2026-03-26T14:56:34+0800","dateFinished":"2026-03-26T14:56:35+0800","status":"FINISHED"},{"text":"%python\n","user":"anonymous","dateUpdated":"2026-03-26T14:56:34+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774508194783_1340099490","id":"paragraph_1774508194783_1340099490","dateCreated":"2026-03-26T14:56:34+0800","status":"READY"}],"name":"The Weather-Mood Hypothesis-Analysis ","id":"2MPYEUDMF","defaultInterpreterGroup":"spark","version":"0.12.0","noteParams":{},"noteForms":{},"angularObjects":{},"config":{"isZeppelinNotebookCronEnable":false,"looknfeel":"default","personalizedMode":"false"},"info":{},"path":"/The Weather-Mood Hypothesis-Analysis "}