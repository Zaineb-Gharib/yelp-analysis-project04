ort functions as F\n\n# Compare the share of 1-star reviews between rainy days (1) and non-rainy days (0)\none_star_rain = final_df.withColumn(\n    \"is_one_star\",\n    F.when(F.col(\"stars\") == 1, 1).otherwise(0)\n)\n\none_star_rain.groupBy(\"rain_flag\").avg(\"is_one_star\").show()","user":"anonymous","dateUpdated":"2026-03-25T19:14:54+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+---------+-------------------+\n|rain_flag|   avg(is_one_star)|\n+---------+-------------------+\n|        1|0.14832754972215773|\n|        0|0.15687459137339732|\n+---------+-------------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=55"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=56"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=57"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774436832153_1229848262","id":"paragraph_1774436832153_1229848262","dateCreated":"2026-03-25T19:07:12+0800","dateStarted":"2026-03-25T19:14:54+0800","dateFinished":"2026-03-25T19:14:56+0800","status":"FINISHED"},{"text":"%pyspark\n# Compare 1-star reviews during heavy rain (1) vs normal days (0)\none_star_rain.groupBy(\"heavy_rain_flag\").avg(\"is_one_star\").show()","user":"anonymous","dateUpdated":"2026-03-25T19:19:36+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+---------------+-------------------+\n|heavy_rain_flag|   avg(