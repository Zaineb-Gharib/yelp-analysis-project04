{"paragraphs":[{"text":"y%pyspark\n# Use the correct database\nspark.sql(\"USE yelp_db\")\n\n# Check if review table exists\nspark.sql(\"SHOW TABLES\").show()","user":"anonymous","dateUpdated":"2026-03-26T15:02:18+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+---------+-------------+-----------+\n|namespace|    tableName|isTemporary|\n+---------+-------------+-----------+\n|  yelp_db|json_business|      false|\n|  yelp_db|     business|      false|\n|  yelp_db|       review|      false|\n|  yelp_db|  json_review|      false|\n|  yelp_db|    json_user|      false|\n|  yelp_db|        users|      false|\n|  yelp_db| json_checkin|      false|\n|  yelp_db|      checkin|      false|\n|  yelp_db|     json_tip|      false|\n|  yelp_db|          tip|      false|\n|  yelp_db|      weather|      false|\n|  yelp_db| weather_data|      false|\n+---------+-------------+-----------+\n\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774422530310_1303220344","id":"paragraph_1774422530310_1303220344","dateCreated":"2026-03-25T15:08:50+0800","dateStarted":"2026-03-25T15:11:19+0800","dateFinished":"2026-03-25T15:11:19+0800","status":"FINISHED","focus":false},{"text":"%pyspark\nfrom pyspark.sql import functions as F\n\nweather_raw = spark.read.csv(\n    \"hdfs:///user/hive/warehouse/noaa_weather/*.CSV\",\n    header=True,\n    inferSchema=True\n)\n\nprint(\"Row count:\", weather_raw.count())\nweather_raw.printSchema()\nweather_raw.show(10, truncate=False)","user":"anonymous","dateUpdated":"2026-03-25T16:37:21+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Row count: 22419\nroot\n |-- STATION: string (nullable = true)\n |-- NAME: string (nullable = true)\n |-- DATE: date (nullable = true)\n |-- AWND: double (nullable = true)\n |-- PRCP: double (nullable = true)\n |-- TMAX: integer (nullable = true)\n |-- TMIN: integer (nullable = true)\n\n+-----------+--------------------------+----------+-----+----+----+----+\n|STATION    |NAME                      |DATE      |AWND |PRCP|TMAX|TMIN|\n+-----------+--------------------------+----------+-----+----+----+----+\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-01|7.83 |2.13|76  |63  |\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-02|9.84 |0.42|78  |61  |\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-03|4.47 |0.0 |74  |58  |\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-04|9.17 |0.0 |62  |48  |\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-05|5.14 |0.17|66  |46  |\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-06|14.09|0.58|54  |33  |\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-07|15.21|0.0 |39  |27  |\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-08|6.49 |0.0 |46  |29  |\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-09|10.51|0.0 |63  |33  |\n|USW00012916|NEW ORLEANS AIRPORT, LA US|2017-01-10|9.84 |0.0 |73  |52  |\n+-----------+--------------------------+----------+-----+----+----+----+\nonly showing top 10 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=11"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=12"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=13"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=14"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=15"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774422805299_628948688","id":"paragraph_1774422805299_628948688","dateCreated":"2026-03-25T15:13:25+0800","dateStarted":"2026-03-25T16:37:21+0800","dateFinished":"2026-03-25T16:37:24+0800","status":"FINISHED"},{"text":"%pyspark\nweather_df = weather_raw.withColumn(\n    \"city\",\n    F.when(F.col(\"NAME\").contains(\"PHILADELPHIA\"), \"Philadelphia\")\n     .when(F.col(\"NAME\").contains(\"TAMPA\"), \"Tampa\")\n     .when(F.col(\"NAME\").contains(\"INDIANAPOLIS\"), \"Indianapolis\")\n     .when(F.col(\"NAME\").contains(\"NASHVILLE\"), \"Nashville\")\n     .when(F.col(\"NAME\").contains(\"TUCSON\"), \"Tucson\")\n     .when(F.col(\"NAME\").contains(\"NEW ORLEANS\"), \"New Orleans\")\n     .when(F.col(\"NAME\").contains(\"ST PETERSBURG\"), \"St. Petersburg\")\n     .when(F.col(\"NAME\").contains(\"RENO\"), \"Reno\")\n     .when(F.col(\"NAME\").contains(\"SANTA BARBARA\"), \"Santa Barbara\")\n     .when(F.col(\"NAME\").contains(\"BOISE\"), \"Boise\")\n     .when(F.col(\"NAME\").contains(\"ST LOUIS\"), \"St. Louis\")\n)\n\nweather_df.select(\"NAME\", \"city\").show(20, False)","user":"anonymous","dateUpdated":"2026-03-25T16:43:21+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------------------+-----------+\n|NAME                      |city       |\n+--------------------------+-----------+\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n|NEW ORLEANS AIRPORT, LA US|New Orleans|\n+--------------------------+-----------+\nonly showing top 20 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=16"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774427841816_1569173371","id":"paragraph_1774427841816_1569173371","dateCreated":"2026-03-25T16:37:21+0800","dateStarted":"2026-03-25T16:43:21+0800","dateFinished":"2026-03-25T16:43:22+0800","status":"FINISHED"},{"text":"%pyspark\nweather_clean = weather_df.select(\n    \"city\",\n    \"DATE\",\n    F.col(\"PRCP\").alias(\"precip_in\"),\n    F.col(\"TMAX\").alias(\"temp_max_f\"),\n    F.col(\"TMIN\").alias(\"temp_min_f\"),\n    F.col(\"AWND\").alias(\"wind_mph\")\n)\n\nweather_clean.show(10, False)\n","user":"anonymous","dateUpdated":"2026-03-25T16:59:08+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-----------+----------+---------+----------+----------+--------+\n|city       |DATE      |precip_in|temp_max_f|temp_min_f|wind_mph|\n+-----------+----------+---------+----------+----------+--------+\n|New Orleans|2017-01-01|2.13     |76        |63        |7.83    |\n|New Orleans|2017-01-02|0.42     |78        |61        |9.84    |\n|New Orleans|2017-01-03|0.0      |74        |58        |4.47    |\n|New Orleans|2017-01-04|0.0      |62        |48        |9.17    |\n|New Orleans|2017-01-05|0.17     |66        |46        |5.14    |\n|New Orleans|2017-01-06|0.58     |54        |33        |14.09   |\n|New Orleans|2017-01-07|0.0      |39        |27        |15.21   |\n|New Orleans|2017-01-08|0.0      |46        |29        |6.49    |\n|New Orleans|2017-01-09|0.0      |63        |33        |10.51   |\n|New Orleans|2017-01-10|0.0      |73        |52        |9.84    |\n+-----------+----------+---------+----------+----------+--------+\nonly showing top 10 rows\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=28"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774429053561_1785575000","id":"paragraph_1774429053561_1785575000","dateCreated":"2026-03-25T16:57:33+0800","dateStarted":"2026-03-25T16:59:08+0800","dateFinished":"2026-03-25T16:59:09+0800","status":"FINISHED"},{"text":"%pyspark\nweather_ready = weather_clean.withColumn(\n    \"rain_flag\", F.when(F.col(\"precip_in\") >= 0.2, 1).otherwise(0)\n).withColumn(\n    \"heavy_rain_flag\", F.when(F.col(\"precip_in\") >= 0.5, 1).otherwise(0)\n).withColumn(\n    \"strong_wind_flag\", F.when(F.col(\"wind_mph\") >= 20, 1).otherwise(0)\n).withColumn(\n    \"extreme_heat_flag\", F.when(F.col(\"temp_max_f\") >= 95, 1).otherwise(0)\n)\n\nweather_ready.groupBy(\n    \"rain_flag\", \"heavy_rain_flag\", \"strong_wind_flag\", \"extreme_heat_flag\"\n).count().show(50, False)","user":"anonymous","dateUpdated":"2026-03-25T17:00:25+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+---------+---------------+----------------+-----------------+-----+\n|rain_flag|heavy_rain_flag|strong_wind_flag|extreme_heat_flag|count|\n+---------+---------------+----------------+-----------------+-----+\n|0        |0              |0               |1                |1593 |\n|1        |1              |0               |0                |1427 |\n|0        |0              |0               |0                |17987|\n|1        |0              |0               |0                |1236 |\n|0        |0              |1               |0                |45   |\n|1        |0              |0               |1                |52   |\n|1        |0              |1               |0                |11   |\n|1        |1              |1               |0                |20   |\n|1        |1              |0               |1                |48   |\n+---------+---------------+----------------+-----------------+-----+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=29"},{"jobUrl":"http://172.16.193.135:4040/jobs/job?id=30"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1774429148812_1471150104","id":"paragraph_1774429148812_1471150104","dateCreated":"2026-03-25T16:59:08+0800","dateStarted":"2026-03-25T17:00:26+0800","dateFinished":"2026-03-25T17:00:27+0800","status":"FINISHED"},{"text":"%pyspark\nweather_final = weather_ready.select(\n    \"city\",\n    F.col(\"DATE\").alias(\"date\"),\n    \"precip_in\",\n    \"temp_max_f\",\n    \"temp_min_f\",\n    \"wind_mph\",\n    \"rain_flag\",\n    \"heavy_rain_flag\",\n    \"strong_wind_flag\",\n    \"extreme_heat_flag\"\n)\n\nweather_final.show(10, False)","user":"anonymous","dateUpdated":"2026-03-25T17:02:06+0800","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCC