    {
      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Convert to Pandas and take top 20\nrank_checkin_pd \u003d rank_checkin.toPandas().head(20)\n\n# Create horizontal bar chart\nplt.figure(figsize\u003d(12, 10))\nbars \u003d plt.barh(rank_checkin_pd[\u0027name\u0027], rank_checkin_pd[\u0027checkin_count\u0027], color\u003d\u0027#F18F01\u0027, edgecolor\u003d\u0027black\u0027)\nplt.xlabel(\u0027Number of Check-ins\u0027, fontsize\u003d12)\nplt.ylabel(\u0027Business Name\u0027, fontsize\u003d12)\nplt.title(\u0027Top 20 Businesses by Check-in Counts\u0027, fontsize\u003d14, fontweight\u003d\u0027bold\u0027)\n\n# Add value labels on bars\nfor i, (name, count) in enumerate(zip(rank_checkin_pd[\u0027name\u0027], rank_checkin_pd[\u0027checkin_count\u0027])):\n    plt.text(count + 1000, i, f\u0027{count:,}\u0027, va\u003d\u0027center\u0027, fontsize\u003d9)\n\n# Highlight top 3 businesses in red\ntop_3 \u003d rank_checkin_pd.head(3)\nfor i, row in top_3.iterrows():\n    plt.barh([row[\u0027name\u0027]], [row[\u0027checkin_count\u0027]], color\u003d\u0027#D32F2F\u0027, edgecolor\u003d\u0027black\u0027)\n    plt.text(row[\u0027checkin_count\u0027] + 1000, i, f\u0027{row[\"checkin_count\"]:,}\u0027, va\u003d\u0027center\u0027, fontsize\u003d9, fontweight\u003d\u0027bold\u0027)\n\nplt.tight_layout()\nplt.show()",
