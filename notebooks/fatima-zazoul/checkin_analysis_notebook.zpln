    {
      "title": "Top Businesses by Check-in Counts",
      "text": "%pyspark\n# Read business with name\nbusiness_name \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/business\")\nbusiness_name \u003d business_name.select(\n    col(\"_c0\").alias(\"business_id\"),\n    col(\"_c1\").alias(\"name\"),\n    col(\"_c3\").alias(\"city\")\n)\n\nrank_checkin \u003d checkin.groupBy(\"business_id\").count() \\\n    .join(business_name, \"business_id\") \\\n    .select(\"name\", \"city\", col(\"count\").alias(\"checkin_count\")) \\\n    .orderBy(col(\"checkin_count\").desc()) \\\n    .limit(50)\n\nrank_checkin.show(50, truncate\u003dFalse)",
