    {
      "title": "Most Popular Cities for Check-ins",
      "text": "%pyspark\n# Read business data\nbusiness \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/business\")\nbusiness \u003d business.select(\n    col(\"_c0\").alias(\"business_id\"),\n    col(\"_c3\").alias(\"city\")\n)\n\npopular_city \u003d checkin.join(business, \"business_id\") \\\n    .groupBy(\"city\") \\\n    .count() \\\n    .orderBy(col(\"count\").desc()) \\\n    .limit(10)\n\npopular_city.show()",
