{
  "paragraphs": [
    {
      "text": "%pyspark\nfrom pyspark.sql.functions import col, year, month, hour, split, explode\n\n# Load checkin data\ncheckin_raw \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/checkin\")\n\n# Parse checkin data (split dates into individual rows)\ncheckin \u003d checkin_raw.select(\n    col(\"_c0\").alias(\"business_id\"),\n    explode(split(col(\"_c1\"), \", \")).alias(\"checkin_datetime\")\n).filter(col(\"checkin_datetime\") !\u003d \"\")\n\n# Extract date and time\ncheckin \u003d checkin.withColumn(\"checkin_date\", split(col(\"checkin_datetime\"), \" \")[0]) \\\n    .withColumn(\"checkin_time\", split(col(\"checkin_datetime\"), \" \")[1])\n\nprint(f\"✅ Loaded {checkin.count():,} check-in records\")\ncheckin.show(5)",
      "user": "anonymous",
      "dateUpdated": "2026-03-25 17:20:44.277",
