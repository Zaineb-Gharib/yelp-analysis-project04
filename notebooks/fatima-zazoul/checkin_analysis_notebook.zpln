    {
      "title": "Seasonality: Ice Cream vs Soup",
      "text": "%pyspark\nfrom pyspark.sql.functions import month, when, col\n\n# Read review data\nreview \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/review\")\nreview \u003d review.select(\n    col(\"_c2\").alias(\"business_id\"),\n    col(\"_c9\").alias(\"date_only\")\n)\n\n# Read business with categories\nbusiness_cat \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/business\")\nbusiness_cat \u003d business_cat.select(\n    col(\"_c0\").alias(\"business_id\"),\n    col(\"_c12\").alias(\"categories\")\n)\n\n# Seasonality analysis\nseasonality \u003d review.join(business_cat, \"business_id\") \\\n    .filter((col(\"categories\").contains(\"Ice Cream\")) | (col(\"categories\").contains(\"Soup\"))) \\\n    .withColumn(\"cuisine_type\", \n        when(col(\"categories\").contains(\"Ice Cream\"), \"Ice Cream\").otherwise(\"Soup\")) \\\n    .withColumn(\"month\", month(col(\"date_only\").cast(\"date\"))) \\\n    .groupBy(\"cuisine_type\", \"month\") \\\n    .count() \\\n    .orderBy(\"cuisine_type\", \"month\")\n\nseasonality.show()",
      "user": "anonymous",
      "dateUpdated": "2026-03-25 20:42:32.123",
      "progress": 0,
