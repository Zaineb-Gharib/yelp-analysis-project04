    {
      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Convert to Pandas\nseasonality_pd \u003d seasonality.toPandas()\n\n# Separate Ice Cream and Soup\nice_cream \u003d seasonality_pd[seasonality_pd[\u0027cuisine_type\u0027] \u003d\u003d \u0027Ice Cream\u0027]\nsoup \u003d seasonality_pd[seasonality_pd[\u0027cuisine_type\u0027] \u003d\u003d \u0027Soup\u0027]\n\n# Create line chart\nplt.figure(figsize\u003d(12, 6))\nplt.plot(ice_cream[\u0027month\u0027], ice_cream[\u0027count\u0027], \u0027o-\u0027, linewidth\u003d2, color\u003d\u0027green\u0027, label\u003d\u0027Ice Cream\u0027)\nplt.plot(soup[\u0027month\u0027], soup[\u0027count\u0027], \u0027s-\u0027, linewidth\u003d2, color\u003d\u0027red\u0027, label\u003d\u0027Soup\u0027)\nplt.xlabel(\u0027Month\u0027, fontsize\u003d12)\nplt.ylabel(\u0027Number of Reviews\u0027, fontsize\u003d12)\nplt.title(\u0027Seasonality: Ice Cream vs Soup Reviews\u0027, fontsize\u003d14)\nplt.xticks(range(1, 13), [\u0027Jan\u0027, \u0027Feb\u0027, \u0027Mar\u0027, \u0027Apr\u0027, \u0027May\u0027, \u0027Jun\u0027, \u0027Jul\u0027, \u0027Aug\u0027, \u0027Sep\u0027, \u0027Oct\u0027, \u0027Nov\u0027, \u0027Dec\u0027])\nplt.legend()\nplt.grid(True, alpha\u003d0.3)\nplt.tight_layout()\nplt.show()",
