      "title": "",
      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Convert to Pandas for plotting\ncheckin_year_pd \u003d checkin_year.toPandas()\n\n# Create line chart\nplt.figure(figsize\u003d(12, 6))\nplt.plot(checkin_year_pd[\u0027year\u0027], checkin_year_pd[\u0027count\u0027], marker\u003d\u0027o\u0027, linewidth\u003d2, markersize\u003d8, color\u003d\u0027#2E86AB\u0027)\nplt.fill_between(checkin_year_pd[\u0027year\u0027], checkin_year_pd[\u0027count\u0027], alpha\u003d0.3, color\u003d\u0027#2E86AB\u0027)\nplt.xlabel(\u0027Year\u0027, fontsize\u003d12)\nplt.ylabel(\u0027Number of Check-ins\u0027, fontsize\u003d12)\nplt.title(\u0027Check-ins per Year (2010-2022)\u0027, fontsize\u003d14, fontweight\u003d\u0027bold\u0027)\nplt.grid(True, alpha\u003d0.3)\n\n# Add value labels on points\nfor i, row in checkin_year_pd.iterrows():\n    plt.text(row[\u0027year\u0027], row[\u0027count\u0027] + 50000, f\"{row[\u0027count\u0027]:,}\", ha\u003d\u0027center\u0027, fontsize\u003d9)\n\nplt.tight_layout()\nplt.show()",
