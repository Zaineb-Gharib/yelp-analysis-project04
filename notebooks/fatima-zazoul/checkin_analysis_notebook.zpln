    {
      "title": "Top Businesses by Check-in Counts",
      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Convert to Pandas\ncheckin_hour_pd \u003d checkin_hour.toPandas()\n\n# Create bar chart\nplt.figure(figsize\u003d(14, 6))\nbars \u003d plt.bar(checkin_hour_pd[\u0027hour\u0027], checkin_hour_pd[\u0027count\u0027], color\u003d\u0027#F18F01\u0027, edgecolor\u003d\u0027black\u0027)\nplt.xlabel(\u0027Hour of Day\u0027, fontsize\u003d12)\nplt.ylabel(\u0027Number of Check-ins\u0027, fontsize\u003d12)\nplt.title(\u0027Check-ins by Hour (24-Hour Pattern)\u0027, fontsize\u003d14, fontweight\u003d\u0027bold\u0027)\nplt.xticks(range(0, 24, 2))\nplt.grid(axis\u003d\u0027y\u0027, alpha\u003d0.3)\n\n# Find peak hour\nmax_row \u003d checkin_hour_pd.loc[checkin_hour_pd[\u0027count\u0027].idxmax()]\npeak_hour \u003d int(max_row[\u0027hour\u0027])\npeak_count \u003d max_row[\u0027count\u0027]\n\n# Highlight peak bar in red\nfor bar in bars:\n    if bar.get_x() + bar.get_width()/2 \u003d\u003d peak_hour:\n        bar.set_color(\u0027#D32F2F\u0027)\n        bar.set_edgecolor(\u0027black\u0027)\n\n# Add peak annotation\nplt.annotate(f\u0027Peak: {peak_count:,} check-ins\\nat {peak_hour}:00\u0027, \n             xy\u003d(peak_hour, peak_count), \n             xytext\u003d(peak_hour-3, peak_count + 50000),\n             arrowprops\u003ddict(arrowstyle\u003d\u0027-\u003e\u0027, color\u003d\u0027red\u0027, lw\u003d1.5),\n             fontsize\u003d10, fontweight\u003d\u0027bold\u0027, ha\u003d\u0027center\u0027)\n\n# Add value labels on top of bars (only for peaks)\nfor i, row in checkin_hour_pd.iterrows():\n    if row[\u0027count\u0027] \u003e 10000:  # Only label bars with \u003e10,000\n        plt.text(row[\u0027hour\u0027], row[\u0027count\u0027] + 1000, f\"{row[\u0027count\u0027]:,}\", \n                 ha\u003d\u0027center\u0027, fontsize\u003d8, rotation\u003d45)\n\nplt.tight_layout()\nplt.show()",
