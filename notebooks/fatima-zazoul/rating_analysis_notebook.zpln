    {
      "title": "Rating Distribution (1-5 Stars)",
      "text": "%pyspark\nfrom pyspark.sql.functions import col, count, round\n\n# Read review data\nreview \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/review\")\nreview \u003d review.select(col(\"_c3\").cast(\"int\").alias(\"stars\"))\n\n# Calculate rating distribution\ntotal \u003d review.count()\nrating_dist \u003d review.groupBy(\"stars\").count().orderBy(\"stars\")\nrating_dist \u003d rating_dist.withColumn(\"percentage\", round((col(\"count\") / total) * 100, 2))\nrating_dist.show()",
      "user": "anonymous",
      "dateUpdated": "2026-03-25 20:45:40.676",
