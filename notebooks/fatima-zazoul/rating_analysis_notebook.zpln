    {
      "title": "Top Businesses with Highest Average Rating",
      "text": "%pyspark\nfrom pyspark.sql.functions import col, avg, count, round as spark_round\nimport matplotlib.pyplot as plt\n\n# Read data\nreview \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/review\")\nreview \u003d review.select(\n    col(\"_c2\").alias(\"business_id\"),\n    col(\"_c3\").cast(\"int\").alias(\"stars\")\n)\n\nbusiness \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/business\")\nbusiness \u003d business.select(\n    col(\"_c0\").alias(\"business_id\"),\n    col(\"_c1\").alias(\"name\"),\n    col(\"_c3\").alias(\"city\"),\n    col(\"_c12\").alias(\"categories\")\n)\n\n# Calculate business average rating\nbusiness_avg \u003d review.groupBy(\"business_id\").agg(\n    avg(\"stars\").alias(\"avg_rating\"),\n    count(\"stars\").alias(\"review_count\")\n).filter(col(\"review_count\") \u003e\u003d 50)\n\n# Join with business info\ntop_rated \u003d business_avg.join(business, \"business_id\") \\\n    .select(\"name\", spark_round(\"avg_rating\", 2).alias(\"avg_rating\")) \\\n    .orderBy(col(\"avg_rating\").desc()) \\\n    .limit(50)\n\nprint(\"\u003d\u003d\u003d TOP 20 BUSINESSES WITH HIGHEST AVERAGE RATING \u003d\u003d\u003d\")\ntop_rated.show(20, truncate\u003dFalse)\n\n# Create chart\ntop_rated_pd \u003d top_rated.toPandas().head(20)\n\nplt.figure(figsize\u003d(14, 10))\nbars \u003d plt.barh(top_rated_pd[\u0027name\u0027], top_rated_pd[\u0027avg_rating\u0027], color\u003d\u0027coral\u0027)\nplt.xlabel(\u0027Average Rating\u0027)\nplt.ylabel(\u0027Business Name\u0027)\nplt.title(\u0027Top 20 Businesses with Highest Average Rating (min 50 reviews)\u0027)\nplt.xlim(4.5, 5.0)\n\nfor bar, val in zip(bars, top_rated_pd[\u0027avg_rating\u0027]):\n    plt.text(bar.get_width() + 0.01, bar.get_y() + bar.get_height()/2, f\u0027{val:.2f}\u0027, ha\u003d\u0027left\u0027, va\u003d\u0027center\u0027)\n\nplt.tight_layout()\nplt.show()",
