    {
      "title": "Top 10 Cities with Highest Ratings",
      "text": "%pyspark\nfrom pyspark.sql.functions import col, count, avg\nimport matplotlib.pyplot as plt\n\n# Make sure data is loaded\nreview \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/review\")\nreview \u003d review.select(\n    col(\"_c2\").alias(\"business_id\"),\n    col(\"_c3\").cast(\"int\").alias(\"stars\")\n)\n\nbusiness \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/business\")\nbusiness \u003d business.select(\n    col(\"_c0\").alias(\"business_id\"),\n    col(\"_c1\").alias(\"name\"),\n    col(\"_c3\").alias(\"city\")\n)\n\n# Run the query\ncity_ratings \u003d review.join(business, \"business_id\") \\\n    .groupBy(business[\"city\"]) \\\n    .agg(count(\"*\").alias(\"review_count\"), avg(review[\"stars\"]).alias(\"avg_rating\")) \\\n    .filter(col(\"review_count\") \u003e\u003d 100) \\\n    .orderBy(col(\"avg_rating\").desc()) \\\n    .limit(10)\n\n# Show the table\ncity_ratings.show()\n\n# Create the chart\ncity_ratings_pd \u003d city_ratings.toPandas()\n\nplt.figure(figsize\u003d(12, 8))\nbars \u003d plt.bar(city_ratings_pd[\u0027city\u0027], city_ratings_pd[\u0027avg_rating\u0027], color\u003d\u0027lightgreen\u0027)\nplt.xlabel(\u0027City\u0027)\nplt.ylabel(\u0027Average Rating\u0027)\nplt.title(\u0027Top 10 Cities with Highest Ratings\u0027)\nplt.xticks(rotation\u003d45, ha\u003d\u0027right\u0027)\nplt.ylim(4.0, 5.0)\n\nfor bar, val in zip(bars, city_ratings_pd[\u0027avg_rating\u0027]):\n    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.01, f\u0027{val:.2f}\u0027, ha\u003d\u0027center\u0027, va\u003d\u0027bottom\u0027)\n\nplt.tight_layout()\nplt.show()",
