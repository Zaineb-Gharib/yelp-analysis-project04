      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Create the chart\ntop_businesses_pd \u003d top_businesses.toPandas()\n\nplt.figure(figsize\u003d(14, 10))\nbars \u003d plt.barh(top_businesses_pd[\u0027name\u0027], top_businesses_pd[\u0027five_star_count\u0027], color\u003d\u0027gold\u0027)\nplt.xlabel(\u0027Number of 5-Star Reviews\u0027, fontsize\u003d12)\nplt.ylabel(\u0027Business Name\u0027, fontsize\u003d12)\nplt.title(\u0027Top 20 Businesses with Most 5-Star Reviews\u0027, fontsize\u003d14, fontweight\u003d\u0027bold\u0027)\n\n# Add value labels\nfor i, (name, count) in enumerate(zip(top_businesses_pd[\u0027name\u0027], top_businesses_pd[\u0027five_star_count\u0027])):\n    plt.text(count + 100, i, f\u0027{count:,}\u0027, va\u003d\u0027center\u0027, fontsize\u003d9)\n\nplt.tight_layout()\nplt.show()",
