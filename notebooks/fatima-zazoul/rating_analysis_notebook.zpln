    {
      "title": "Top Businesses with Most 5-Star Reviews",
      "text": "%pyspark\nfrom pyspark.sql.functions import col, count\n\n# Make sure data is loaded\nreview \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/review\")\nreview \u003d review.select(\n    col(\"_c2\").alias(\"business_id\"),\n    col(\"_c3\").cast(\"int\").alias(\"stars\")\n)\n\nbusiness \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/business\")\nbusiness \u003d business.select(\n    col(\"_c0\").alias(\"business_id\"),\n    col(\"_c1\").alias(\"name\")\n)\n\n# Run the query\nfive_star \u003d review.filter(col(\"stars\") \u003d\u003d 5)\ntop_businesses \u003d five_star.groupBy(\"business_id\").count() \\\n    .join(business, \"business_id\") \\\n    .select(\"name\", col(\"count\").alias(\"five_star_count\")) \\\n    .orderBy(col(\"five_star_count\").desc()) \\\n    .limit(20)\n\n# Show the table\ntop_businesses.show(20, truncate\u003dFalse)",
