    {
      "title": "Nightlife: Weekend vs Weekday Ratings",
      "text": "%pyspark\nfrom pyspark.sql.functions import dayofweek, when, count, avg, col\nimport matplotlib.pyplot as plt\n\n# Make sure data is loaded\nreview \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/review\")\nreview \u003d review.select(\n    col(\"_c2\").alias(\"business_id\"),\n    col(\"_c3\").cast(\"int\").alias(\"stars\"),\n    col(\"_c9\").alias(\"date_only\")\n)\n\nbusiness \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/business\")\nbusiness \u003d business.select(\n    col(\"_c0\").alias(\"business_id\"),\n    col(\"_c12\").alias(\"categories\")\n)\n\n# Run the query\nnightlife \u003d review.join(business, \"business_id\") \\\n    .filter(col(\"categories\").contains(\"Nightlife\")) \\\n    .withColumn(\"day_type\", \n        when(dayofweek(col(\"date_only\").cast(\"date\")).isin([1,7]), \"Weekend\").otherwise(\"Weekday\")) \\\n    .groupBy(\"day_type\") \\\n    .agg(count(\"*\").alias(\"review_count\"), avg(\"stars\").alias(\"avg_rating\"))\n\n# Show the table\nnightlife.show()\n\n# Create the chart\nnightlife_pd \u003d nightlife.toPandas()\n\nplt.figure(figsize\u003d(6, 6))\nbars \u003d plt.bar(nightlife_pd[\u0027day_type\u0027], nightlife_pd[\u0027avg_rating\u0027], color\u003d[\u0027lightblue\u0027, \u0027lightcoral\u0027])\nplt.xlabel(\u0027Day Type\u0027)\nplt.ylabel(\u0027Average Rating\u0027)\nplt.title(\u0027Nightlife: Weekend vs Weekday Ratings\u0027)\nplt.ylim(3.5, 4.0)\n\nfor bar, val in zip(bars, nightlife_pd[\u0027avg_rating\u0027]):\n    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.01, f\u0027{val:.2f}\u0027, ha\u003d\u0027center\u0027, va\u003d\u0027bottom\u0027)\n\nplt.show()",
