    {
      "title": "Weekly Rating Frequency",
      "text": "%pyspark\nfrom pyspark.sql.functions import dayofweek, when, count, avg, col\nimport matplotlib.pyplot as plt\n\n# Make sure data is loaded\nreview \u003d spark.read.option(\"header\", \"false\").option(\"delimiter\", \"\\u0001\").csv(\"/user/hive/warehouse/review\")\nreview \u003d review.select(\n    col(\"_c2\").alias(\"business_id\"),\n    col(\"_c3\").cast(\"int\").alias(\"stars\"),\n    col(\"_c9\").alias(\"date_only\")\n)\n\n# Run the query\nweekly \u003d review.withColumn(\"review_date\", col(\"date_only\").cast(\"date\")) \\\n    .filter(col(\"date_only\").isNotNull()) \\\n    .groupBy(dayofweek(\"review_date\").alias(\"day_num\")) \\\n    .agg(count(\"*\").alias(\"review_count\"), avg(\"stars\").alias(\"avg_rating\")) \\\n    .orderBy(\"day_num\")\n\nweekly \u003d weekly.withColumn(\"day\", \n    when(col(\"day_num\") \u003d\u003d 1, \"Sunday\")\n    .when(col(\"day_num\") \u003d\u003d 2, \"Monday\")\n    .when(col(\"day_num\") \u003d\u003d 3, \"Tuesday\")\n    .when(col(\"day_num\") \u003d\u003d 4, \"Wednesday\")\n    .when(col(\"day_num\") \u003d\u003d 5, \"Thursday\")\n    .when(col(\"day_num\") \u003d\u003d 6, \"Friday\")\n    .when(col(\"day_num\") \u003d\u003d 7, \"Saturday\"))\n\n# Show the table (without NULL)\nweekly.select(\"day\", \"avg_rating\").filter(col(\"day\").isNotNull()).show()\n\n# Create the chart\nweekly_pd \u003d weekly.select(\"day\", \"avg_rating\").filter(col(\"day\").isNotNull()).toPandas()\n\nplt.figure(figsize\u003d(10, 6))\nbars \u003d plt.bar(weekly_pd[\u0027day\u0027], weekly_pd[\u0027avg_rating\u0027], color\u003d\u0027skyblue\u0027)\nplt.xlabel(\u0027Day of Week\u0027)\nplt.ylabel(\u0027Average Rating\u0027)\nplt.title(\u0027Weekly Rating Frequency\u0027)\nplt.xticks(rotation\u003d45)\nplt.ylim(3.5, 4.0)\n\nfor bar, val in zip(bars, weekly_pd[\u0027avg_rating\u0027]):\n    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.01, f\u0027{val:.2f}\u0027, ha\u003d\u0027center\u0027, va\u003d\u0027bottom\u0027)\n\nplt.tight_layout()\nplt.show()",
      "user": "anonymous",
      "dateUpdated": "2026-03-25 20:47:58.916",
      "progress": 0,
