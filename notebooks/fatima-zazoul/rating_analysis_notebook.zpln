      "text": "%pyspark\n# Load all your data from HDFS\nbusiness \u003d spark.read.option(\"header\", \"false\").csv(\"/user/hive/warehouse/business\")\nbusiness.createOrReplaceTempView(\"business\")\n\nreview \u003d spark.read.option(\"header\", \"false\").csv(\"/user/hive/warehouse/review\")\nreview.createOrReplaceTempView(\"review\")\n\ncheckin \u003d spark.read.option(\"header\", \"false\").csv(\"/user/hive/warehouse/checkin\")\ncheckin.createOrReplaceTempView(\"checkin\")\n\nusers \u003d spark.read.option(\"header\", \"false\").csv(\"/user/hive/warehouse/users\")\nusers.createOrReplaceTempView(\"users\")\n\ntip \u003d spark.read.option(\"header\", \"false\").csv(\"/user/hive/warehouse/tip\")\ntip.createOrReplaceTempView(\"tip\")\n\nprint(\"✅ ALL DATA LOADED!\")\nprint(f\"Business: {business.count():,}\")\nprint(f\"Review: {review.count():,}\")\nprint(f\"Users: {users.count():,}\")\nprint(f\"Checkin: {checkin.count():,}\")\nprint(f\"Tip: {tip.count():,}\")",
