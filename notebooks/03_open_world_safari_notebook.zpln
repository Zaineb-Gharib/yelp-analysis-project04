    {
      "title": "Restaurant Survival Rate by Income",
      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Survival rate bar chart\nincome_levels \u003d [\u0027Low Income\u0027, \u0027Medium Income\u0027, \u0027High Income\u0027]\nsurvival \u003d [52, 68, 85]\n\nplt.figure(figsize\u003d(8, 5))\nbars \u003d plt.bar(income_levels, survival, color\u003d[\u0027red\u0027, \u0027orange\u0027, \u0027green\u0027])\nplt.xlabel(\u0027Income Level\u0027)\nplt.ylabel(\u0027Survival Rate (%)\u0027)\nplt.title(\u0027Restaurant Survival Rate by Income Level\u0027)\nplt.ylim(0, 100)\n\n# Add numbers on bars\nfor bar, val in zip(bars, survival):\n    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 2, f\u0027{val}%\u0027, ha\u003d\u0027center\u0027)\n\n# Add arrow showing difference\nplt.annotate(\u0027+33% higher\u0027, xy\u003d(2, 85), xytext\u003d(1.5, 60),\n             arrowprops\u003ddict(arrowstyle\u003d\u0027-\u003e\u0027, color\u003d\u0027green\u0027))\n\nplt.show()",
