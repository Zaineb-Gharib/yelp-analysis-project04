    {
      "title": "Income Distribution Histogram",
      "text": "%pyspark\nimport matplotlib.pyplot as plt\n\n# Histogram with mean and median\nmean_inc \u003d income_df[\u0027median_income\u0027].mean()\nmedian_inc \u003d income_df[\u0027median_income\u0027].median()\n\nplt.figure(figsize\u003d(12, 5))\nplt.hist(income_df[\u0027median_income\u0027], bins\u003d50, color\u003d\u0027skyblue\u0027, edgecolor\u003d\u0027black\u0027)\n\n# Add lines\nplt.axvline(mean_inc, color\u003d\u0027red\u0027, linestyle\u003d\u0027--\u0027, linewidth\u003d2, label\u003df\u0027Mean: ${mean_inc:,.0f}\u0027)\nplt.axvline(median_inc, color\u003d\u0027green\u0027, linestyle\u003d\u0027--\u0027, linewidth\u003d2, label\u003df\u0027Median: ${median_inc:,.0f}\u0027)\n\n# Add zones\nplt.axvspan(0, 50000, alpha\u003d0.2, color\u003d\u0027red\u0027, label\u003d\u0027Low Income\u0027)\nplt.axvspan(50000, 75000, alpha\u003d0.2, color\u003d\u0027orange\u0027, label\u003d\u0027Medium Income\u0027)\nplt.axvspan(75000, 250000, alpha\u003d0.2, color\u003d\u0027green\u0027, label\u003d\u0027High Income\u0027)\n\nplt.xlabel(\u0027Income ($)\u0027)\nplt.ylabel(\u0027Number of Tracts\u0027)\nplt.title(\u0027Income Distribution\u0027)\nplt.legend()\nplt.show()",
