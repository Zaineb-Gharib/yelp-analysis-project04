    {
      "text": "%pyspark\n# Create a clean DataFrame with GEOID (tract ID) and Median Income\nincome_df \u003d gdf[[\u0027GEOID\u0027, \u0027B19013EST1\u0027]].copy()\nincome_df.columns \u003d [\u0027tract_id\u0027, \u0027median_income\u0027]\n\n# Remove rows with missing income\nincome_df \u003d income_df.dropna()\n\n# Convert to integer\nincome_df[\u0027median_income\u0027] \u003d income_df[\u0027median_income\u0027].astype(int)\n\nprint(f\"✅ Extracted {len(income_df)} census tracts with income data\")\nprint(f\"\\nIncome range: ${income_df[\u0027median_income\u0027].min():,} - ${income_df[\u0027median_income\u0027].max():,}\")\nprint(f\"Average income: ${income_df[\u0027median_income\u0027].mean():,.0f}\")\n\nprint(\"\\nSample income data:\")\nprint(income_df.head(10))",
      "user": "anonymous",
